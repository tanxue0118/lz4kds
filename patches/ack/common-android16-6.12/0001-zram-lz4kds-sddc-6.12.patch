+static void zram_sddc_similarity_test(struct kunit *test)
+{
+	u8 target[64];
+	u8 shifted[72];
+	unsigned int i;
+
+	for (i = 0; i < ARRAY_SIZE(target); i++)
+		target[i] = i;
+	memset(shifted, 0xa5, sizeof(shifted));
+	memcpy(shifted + 8, target, sizeof(target));
+
+	KUNIT_EXPECT_EQ(test,
+		zram_sddc_match_bytes(target, sizeof(target), target,
+			sizeof(target), ZRAM_SDDC_SAMPLE_HEAD),
+		(u32)sizeof(target));
+	KUNIT_EXPECT_EQ(test,
+		zram_sddc_match_bytes(target, sizeof(target), target,
+			sizeof(target), ZRAM_SDDC_SAMPLE_TAIL),
+		(u32)sizeof(target));
+	KUNIT_EXPECT_EQ(test,
+		zram_sddc_match_bytes(target, sizeof(target), shifted,
+			sizeof(shifted), ZRAM_SDDC_SAMPLE_TAIL),
+		(u32)sizeof(target));
+	KUNIT_EXPECT_EQ(test,
+		zram_sddc_match_bytes(target, sizeof(target), shifted,
+			sizeof(shifted), ZRAM_SDDC_SAMPLE_HEAD |
+			ZRAM_SDDC_SAMPLE_TAIL),
+		(u32)sizeof(target));
+	KUNIT_EXPECT_EQ(test,
+		zram_sddc_match_bytes(target, sizeof(target), shifted,
+			sizeof(shifted), ZRAM_SDDC_SAMPLE_HEAD), 0U);
+}
