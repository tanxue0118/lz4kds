diff --git a/drivers/block/zram/sddc/zram_sddc_codec.c b/drivers/block/zram/sddc/zram_sddc_codec.c
new file mode 100644
--- /dev/null
+++ b/drivers/block/zram/sddc/zram_sddc_codec.c
@@ -0,0 +1,175 @@
+// SPDX-License-Identifier: GPL-2.0-or-later
+
+#include <linux/err.h>
+#include <linux/mm.h>
+#include <linux/sizes.h>
+#include <linux/slab.h>
+#include <linux/string.h>
+#include <linux/vmalloc.h>
+
+#include "zram_sddc_codec.h"
+#include "lz4kd/lz4kd.h"
+
+#define ZRAM_SDDC_BLOCK_SIZE	SZ_4K
+#define ZRAM_SDDC_WINDOW_SIZE	(2 * ZRAM_SDDC_BLOCK_SIZE)
+
+struct zram_sddc_codec {
+	void *encode_state;
+	u8 *delta_window;
+};
+
+bool zram_sddc_codec_available(void)
+{
+	return PAGE_SIZE == ZRAM_SDDC_BLOCK_SIZE;
+}
+
+struct zram_sddc_codec *zram_sddc_codec_create(void)
+{
+	struct zram_sddc_codec *codec;
+
+	if (!zram_sddc_codec_available())
+		return ERR_PTR(-EOPNOTSUPP);
+
+	codec = kzalloc(sizeof(*codec), GFP_KERNEL);
+	if (!codec)
+		return ERR_PTR(-ENOMEM);
+
+	codec->encode_state = kvzalloc(
+		crystal_lz4kd_encode_state_bytes_min(), GFP_KERNEL);
+	codec->delta_window = kvzalloc(ZRAM_SDDC_WINDOW_SIZE, GFP_KERNEL);
+	if (!codec->encode_state || !codec->delta_window) {
+		zram_sddc_codec_destroy(codec);
+		return ERR_PTR(-ENOMEM);
+	}
+
+	return codec;
+}
+
+void zram_sddc_codec_destroy(struct zram_sddc_codec *codec)
+{
+	if (!codec)
+		return;
+
+	kvfree(codec->delta_window);
+	kvfree(codec->encode_state);
+	kfree(codec);
+}
+
+int zram_sddc_codec_compress(struct zram_sddc_codec *codec,
+		const void *src, unsigned int src_len, void *dst,
+		unsigned int *dst_len)
+{
+	int ret;
+
+	if (!codec || !src || !dst || !dst_len || !*dst_len ||
+	    src_len != ZRAM_SDDC_BLOCK_SIZE)
+		return -EINVAL;
+
+	ret = crystal_lz4kd_encode(codec->encode_state, src, dst, src_len,
+				    *dst_len, 0);
+	if (ret < 0)
+		return -EINVAL;
+	if (ret > 0)
+		*dst_len = ret;
+
+	return 0;
+}
+
+int zram_sddc_codec_decompress(struct zram_sddc_codec *codec,
+		const void *src, unsigned int src_len, void *dst,
+		unsigned int *dst_len)
+{
+	int ret;
+
+	if (!codec || !src || !src_len || src_len > ZRAM_SDDC_BLOCK_SIZE ||
+	    !dst || !dst_len ||
+	    *dst_len != ZRAM_SDDC_BLOCK_SIZE)
+		return -EINVAL;
+
+	ret = crystal_lz4kd_decode(src, dst, src_len, *dst_len);
+	if (ret != ZRAM_SDDC_BLOCK_SIZE)
+		return -EINVAL;
+
+	*dst_len = ret;
+	return 0;
+}
+
+int zram_sddc_codec_compress_delta(struct zram_sddc_codec *codec,
+		const void *ref, unsigned int ref_len, const void *src,
+		unsigned int src_len, void *dst, unsigned int *dst_len,
+		unsigned int out_limit)
+{
+	u8 *current_data;
+	int ret;
+
+	if (!codec || !ref || !ref_len || !src || src_len < 16 || !dst ||
+	    !dst_len || !*dst_len || ref_len > ZRAM_SDDC_BLOCK_SIZE ||
+	    src_len > ZRAM_SDDC_BLOCK_SIZE ||
+	    ref_len + src_len > ZRAM_SDDC_WINDOW_SIZE)
+		return -EINVAL;
+
+	memcpy(codec->delta_window, ref, ref_len);
+	current_data = codec->delta_window + ref_len;
+	memcpy(current_data, src, src_len);
+
+	ret = crystal_lz4kd_encode_delta(codec->encode_state,
+			codec->delta_window, current_data, dst, src_len, *dst_len,
+			out_limit);
+	if (ret < 0)
+		return -EINVAL;
+	if (ret > 0)
+		*dst_len = ret;
+
+	return 0;
+}
+
+int
+zram_sddc_codec_decompress_delta_borrowed(struct zram_sddc_codec *codec,
+		const void *src, unsigned int src_len, const void *ref,
+		unsigned int ref_len, const void **restored,
+		unsigned int *restored_len)
+{
+	u8 *current_data;
+	int ret;
+
+	if (!restored || !restored_len)
+		return -EINVAL;
+	*restored = NULL;
+	if (!codec || !src || !src_len ||
+	    src_len > ZRAM_SDDC_BLOCK_SIZE || !ref || !ref_len ||
+	    !*restored_len ||
+	    ref_len > ZRAM_SDDC_BLOCK_SIZE ||
+	    *restored_len != ZRAM_SDDC_BLOCK_SIZE ||
+	    ref_len + *restored_len > ZRAM_SDDC_WINDOW_SIZE)
+		return -EINVAL;
+
+	memcpy(codec->delta_window, ref, ref_len);
+	current_data = codec->delta_window + ref_len;
+	ret = crystal_lz4kd_decode_delta(src, codec->delta_window, current_data,
+					 src_len, *restored_len);
+	if (ret <= 0 || ret > *restored_len)
+		return -EINVAL;
+
+	*restored = current_data;
+	*restored_len = ret;
+	return 0;
+}
+
+int zram_sddc_codec_decompress_delta(struct zram_sddc_codec *codec,
+		const void *src, unsigned int src_len, const void *ref,
+		unsigned int ref_len, void *dst, unsigned int *dst_len)
+{
+	const void *restored;
+	int ret;
+
+	if (!dst || !dst_len)
+		return -EINVAL;
+
+	ret = zram_sddc_codec_decompress_delta_borrowed(codec, src, src_len,
+			ref, ref_len, &restored, dst_len);
+	if (ret)
+		return ret;
+
+	memcpy(dst, restored, *dst_len);
+	return 0;
+}
diff --git a/drivers/block/zram/sddc/zram_sddc_codec.h b/drivers/block/zram/sddc/zram_sddc_codec.h
new file mode 100644
--- /dev/null
+++ b/drivers/block/zram/sddc/zram_sddc_codec.h
@@ -0,0 +1,38 @@
+/* SPDX-License-Identifier: GPL-2.0-or-later */
+#ifndef _ZRAM_SDDC_CODEC_H_
+#define _ZRAM_SDDC_CODEC_H_
+
+#include <linux/types.h>
+
+struct zram_sddc_codec;
+
+bool zram_sddc_codec_available(void);
+struct zram_sddc_codec *zram_sddc_codec_create(void);
+void zram_sddc_codec_destroy(struct zram_sddc_codec *codec);
+
+int zram_sddc_codec_compress(struct zram_sddc_codec *codec,
+		const void *src, unsigned int src_len, void *dst,
+		unsigned int *dst_len);
+int zram_sddc_codec_decompress(struct zram_sddc_codec *codec,
+		const void *src, unsigned int src_len, void *dst,
+		unsigned int *dst_len);
+
+int zram_sddc_codec_compress_delta(struct zram_sddc_codec *codec,
+		const void *ref, unsigned int ref_len, const void *src,
+		unsigned int src_len, void *dst, unsigned int *dst_len,
+		unsigned int out_limit);
+int zram_sddc_codec_decompress_delta(struct zram_sddc_codec *codec,
+		const void *src, unsigned int src_len, const void *ref,
+		unsigned int ref_len, void *dst, unsigned int *dst_len);
+/*
+ * Restore an ordinary stream into the codec's private delta window. The
+ * returned pointer remains valid while the owning zcomp stream is locked and
+ * until another delta operation uses the same codec.
+ */
+int
+zram_sddc_codec_decompress_delta_borrowed(struct zram_sddc_codec *codec,
+		const void *src, unsigned int src_len, const void *ref,
+		unsigned int ref_len, const void **restored,
+		unsigned int *restored_len);
+
+#endif /* _ZRAM_SDDC_CODEC_H_ */
diff --git a/drivers/block/zram/sddc/zram_sddc_codec_test.c b/drivers/block/zram/sddc/zram_sddc_codec_test.c
new file mode 100644
--- /dev/null
+++ b/drivers/block/zram/sddc/zram_sddc_codec_test.c
@@ -0,0 +1,282 @@
+// SPDX-License-Identifier: GPL-2.0-or-later
+
+#include <kunit/test.h>
+#include <linux/err.h>
+#include <linux/mm.h>
+#include <linux/string.h>
+
+#include "zram_sddc_codec.h"
+#include "lz4kd/lz4kd.h"
+
+struct zram_sddc_codec_test_ctx {
+	struct zram_sddc_codec *codec;
+};
+
+static int zram_sddc_codec_test_init(struct kunit *test)
+{
+	struct zram_sddc_codec_test_ctx *ctx;
+
+	ctx = kunit_kzalloc(test, sizeof(*ctx), GFP_KERNEL);
+	if (!ctx)
+		return -ENOMEM;
+
+	ctx->codec = zram_sddc_codec_create();
+	if (IS_ERR(ctx->codec))
+		return PTR_ERR(ctx->codec);
+
+	test->priv = ctx;
+	return 0;
+}
+
+static void zram_sddc_codec_test_exit(struct kunit *test)
+{
+	struct zram_sddc_codec_test_ctx *ctx = test->priv;
+
+	if (!ctx)
+		return;
+
+	zram_sddc_codec_destroy(ctx->codec);
+}
+
+static void zram_sddc_fill_prandom(u8 *buf, size_t len, u32 seed)
+{
+	u32 state = seed;
+	size_t i;
+
+	for (i = 0; i < len; i++) {
+		state ^= state << 13;
+		state ^= state >> 17;
+		state ^= state << 5;
+		buf[i] = state;
+	}
+}
+
+static void zram_sddc_codec_roundtrip_test(struct kunit *test)
+{
+	struct zram_sddc_codec_test_ctx *ctx = test->priv;
+	unsigned int encoded_len = 2 * PAGE_SIZE;
+	unsigned int decoded_len = PAGE_SIZE;
+	u8 *encoded = kunit_kmalloc(test, 2 * PAGE_SIZE, GFP_KERNEL);
+	u8 *decoded = kunit_kmalloc(test, PAGE_SIZE, GFP_KERNEL);
+	u8 *page = kunit_kmalloc(test, PAGE_SIZE, GFP_KERNEL);
+	int ret;
+
+	KUNIT_ASSERT_NOT_NULL(test, encoded);
+	KUNIT_ASSERT_NOT_NULL(test, decoded);
+	KUNIT_ASSERT_NOT_NULL(test, page);
+	memset(page, 0x5a, PAGE_SIZE);
+
+	ret = zram_sddc_codec_compress(ctx->codec, page, PAGE_SIZE,
+					  encoded, &encoded_len);
+	KUNIT_ASSERT_EQ(test, ret, 0);
+	KUNIT_ASSERT_LT(test, encoded_len, (unsigned int)PAGE_SIZE);
+
+	ret = zram_sddc_codec_decompress(ctx->codec, encoded, encoded_len,
+					    decoded, &decoded_len);
+	KUNIT_ASSERT_EQ(test, ret, 0);
+	KUNIT_EXPECT_EQ(test, decoded_len, (unsigned int)PAGE_SIZE);
+	KUNIT_EXPECT_MEMEQ(test, decoded, page, PAGE_SIZE);
+}
+
+static void zram_sddc_codec_raw_contract_test(struct kunit *test)
+{
+	struct zram_sddc_codec_test_ctx *ctx = test->priv;
+	unsigned int encoded_len = 2 * PAGE_SIZE;
+	unsigned int decoded_len = PAGE_SIZE;
+	u8 *encoded = kunit_kmalloc(test, 2 * PAGE_SIZE, GFP_KERNEL);
+	u8 *decoded = kunit_kmalloc(test, PAGE_SIZE, GFP_KERNEL);
+	u8 *page = kunit_kmalloc(test, PAGE_SIZE, GFP_KERNEL);
+	int ret;
+
+	KUNIT_ASSERT_NOT_NULL(test, encoded);
+	KUNIT_ASSERT_NOT_NULL(test, decoded);
+	KUNIT_ASSERT_NOT_NULL(test, page);
+	zram_sddc_fill_prandom(page, PAGE_SIZE, 0x13579bdf);
+
+	ret = zram_sddc_codec_compress(ctx->codec, page, PAGE_SIZE,
+					  encoded, &encoded_len);
+	KUNIT_ASSERT_EQ(test, ret, 0);
+	if (encoded_len >= PAGE_SIZE) {
+		KUNIT_EXPECT_EQ(test, encoded_len, 2U * PAGE_SIZE);
+		return;
+	}
+
+	ret = zram_sddc_codec_decompress(ctx->codec, encoded, encoded_len,
+					    decoded, &decoded_len);
+	KUNIT_ASSERT_EQ(test, ret, 0);
+	KUNIT_EXPECT_MEMEQ(test, decoded, page, PAGE_SIZE);
+}
+
+static void zram_sddc_codec_delta_chain_test(struct kunit *test)
+{
+	struct zram_sddc_codec_test_ctx *ctx = test->priv;
+	unsigned int ref_encoded_len = 2 * PAGE_SIZE;
+	unsigned int cur_encoded_len = 2 * PAGE_SIZE;
+	unsigned int delta_len = 2 * PAGE_SIZE;
+	unsigned int restored_encoded_len = PAGE_SIZE;
+	unsigned int restored_page_len = PAGE_SIZE;
+	const void *restored_encoded;
+	u8 *ref_encoded = kunit_kmalloc(test, 2 * PAGE_SIZE, GFP_KERNEL);
+	u8 *cur_encoded = kunit_kmalloc(test, 2 * PAGE_SIZE, GFP_KERNEL);
+	u8 *delta = kunit_kmalloc(test, 2 * PAGE_SIZE, GFP_KERNEL);
+	u8 *restored_page = kunit_kmalloc(test, PAGE_SIZE, GFP_KERNEL);
+	u8 *ref_page = kunit_kmalloc(test, PAGE_SIZE, GFP_KERNEL);
+	u8 *cur_page = kunit_kmalloc(test, PAGE_SIZE, GFP_KERNEL);
+	int ret;
+
+	KUNIT_ASSERT_NOT_NULL(test, ref_encoded);
+	KUNIT_ASSERT_NOT_NULL(test, cur_encoded);
+	KUNIT_ASSERT_NOT_NULL(test, delta);
+	KUNIT_ASSERT_NOT_NULL(test, restored_page);
+	KUNIT_ASSERT_NOT_NULL(test, ref_page);
+	KUNIT_ASSERT_NOT_NULL(test, cur_page);
+
+	zram_sddc_fill_prandom(ref_page, PAGE_SIZE / 2, 0x2468ace1);
+	memcpy(ref_page + PAGE_SIZE / 2, ref_page, PAGE_SIZE / 2);
+	memcpy(cur_page, ref_page, PAGE_SIZE);
+	cur_page[127] ^= 0x55;
+	cur_page[PAGE_SIZE / 2 + 127] ^= 0x55;
+
+	ret = zram_sddc_codec_compress(ctx->codec, ref_page, PAGE_SIZE,
+					  ref_encoded, &ref_encoded_len);
+	KUNIT_ASSERT_EQ(test, ret, 0);
+	KUNIT_ASSERT_LT(test, ref_encoded_len, (unsigned int)PAGE_SIZE);
+	ret = zram_sddc_codec_compress(ctx->codec, cur_page, PAGE_SIZE,
+					  cur_encoded, &cur_encoded_len);
+	KUNIT_ASSERT_EQ(test, ret, 0);
+	KUNIT_ASSERT_LT(test, cur_encoded_len, (unsigned int)PAGE_SIZE);
+
+	ret = zram_sddc_codec_compress_delta(ctx->codec, ref_encoded,
+			ref_encoded_len, cur_encoded, cur_encoded_len, delta,
+			&delta_len, cur_encoded_len - 1);
+	KUNIT_ASSERT_EQ(test, ret, 0);
+	KUNIT_ASSERT_LT(test, delta_len, cur_encoded_len);
+
+	ret = zram_sddc_codec_decompress_delta_borrowed(ctx->codec, delta,
+			delta_len, ref_encoded, ref_encoded_len, &restored_encoded,
+			&restored_encoded_len);
+	KUNIT_ASSERT_EQ(test, ret, 0);
+	KUNIT_ASSERT_NOT_NULL(test, restored_encoded);
+	KUNIT_ASSERT_EQ(test, restored_encoded_len, cur_encoded_len);
+	KUNIT_EXPECT_MEMEQ(test, restored_encoded, cur_encoded, cur_encoded_len);
+
+	ret = zram_sddc_codec_decompress(ctx->codec, restored_encoded,
+			restored_encoded_len, restored_page, &restored_page_len);
+	KUNIT_ASSERT_EQ(test, ret, 0);
+	KUNIT_EXPECT_MEMEQ(test, restored_page, cur_page, PAGE_SIZE);
+}
+
+static void zram_sddc_codec_full_window_test(struct kunit *test)
+{
+	struct zram_sddc_codec_test_ctx *ctx = test->priv;
+	unsigned int delta_len = 2 * PAGE_SIZE;
+	unsigned int restored_len = PAGE_SIZE;
+	u8 *ref = kunit_kmalloc(test, PAGE_SIZE, GFP_KERNEL);
+	u8 *current_data = kunit_kmalloc(test, PAGE_SIZE, GFP_KERNEL);
+	u8 *delta = kunit_kmalloc(test, 2 * PAGE_SIZE, GFP_KERNEL);
+	u8 *restored = kunit_kmalloc(test, PAGE_SIZE, GFP_KERNEL);
+	int ret;
+
+	KUNIT_ASSERT_NOT_NULL(test, ref);
+	KUNIT_ASSERT_NOT_NULL(test, current_data);
+	KUNIT_ASSERT_NOT_NULL(test, delta);
+	KUNIT_ASSERT_NOT_NULL(test, restored);
+	zram_sddc_fill_prandom(ref, PAGE_SIZE, 0x10203040);
+	memcpy(current_data, ref, PAGE_SIZE);
+	current_data[0] ^= 0xa5;
+	current_data[PAGE_SIZE - 1] ^= 0x5a;
+
+	ret = zram_sddc_codec_compress_delta(ctx->codec, ref, PAGE_SIZE,
+			current_data, PAGE_SIZE, delta, &delta_len,
+			PAGE_SIZE - 1);
+	KUNIT_ASSERT_EQ(test, ret, 0);
+	KUNIT_ASSERT_LT(test, delta_len, (unsigned int)PAGE_SIZE);
+
+	ret = zram_sddc_codec_decompress_delta(ctx->codec, delta, delta_len,
+			ref, PAGE_SIZE, restored, &restored_len);
+	KUNIT_ASSERT_EQ(test, ret, 0);
+	KUNIT_ASSERT_EQ(test, restored_len, (unsigned int)PAGE_SIZE);
+	KUNIT_EXPECT_MEMEQ(test, restored, current_data, PAGE_SIZE);
+}
+
+static void zram_sddc_codec_malformed_test(struct kunit *test)
+{
+	struct zram_sddc_codec_test_ctx *ctx = test->priv;
+	unsigned int encoded_len = 2 * PAGE_SIZE;
+	unsigned int decoded_len = PAGE_SIZE;
+	unsigned int restored_len = PAGE_SIZE;
+	const void *restored = (const void *)1;
+	u8 malformed[4] = { 0 };
+	u8 *encoded = kunit_kmalloc(test, 2 * PAGE_SIZE, GFP_KERNEL);
+	u8 *decoded = kunit_kmalloc(test, PAGE_SIZE, GFP_KERNEL);
+	u8 *page = kunit_kmalloc(test, PAGE_SIZE, GFP_KERNEL);
+	int ret;
+
+	KUNIT_ASSERT_NOT_NULL(test, encoded);
+	KUNIT_ASSERT_NOT_NULL(test, decoded);
+	KUNIT_ASSERT_NOT_NULL(test, page);
+	memset(page, 0x6b, PAGE_SIZE);
+	ret = zram_sddc_codec_compress(ctx->codec, page, PAGE_SIZE,
+					  encoded, &encoded_len);
+	KUNIT_ASSERT_EQ(test, ret, 0);
+	KUNIT_ASSERT_LT(test, 1U, encoded_len);
+	ret = zram_sddc_codec_decompress(ctx->codec, encoded,
+			encoded_len - 1, decoded, &decoded_len);
+	KUNIT_EXPECT_EQ(test, ret, -EINVAL);
+
+	decoded_len = PAGE_SIZE;
+	ret = zram_sddc_codec_decompress(ctx->codec, malformed,
+			sizeof(malformed), decoded, &decoded_len);
+	KUNIT_EXPECT_EQ(test, ret, -EINVAL);
+
+	ret = zram_sddc_codec_decompress_delta_borrowed(ctx->codec,
+			malformed, sizeof(malformed), page, PAGE_SIZE, &restored,
+			&restored_len);
+	KUNIT_EXPECT_EQ(test, ret, -EINVAL);
+	KUNIT_EXPECT_NULL(test, restored);
+}
+
+static void zram_sddc_codec_delta_output_bounds_test(struct kunit *test)
+{
+	u8 *state = kunit_kmalloc(test,
+			crystal_lz4kd_encode_state_bytes_min(), GFP_KERNEL);
+	u8 *window = kunit_kmalloc(test, 2 * PAGE_SIZE, GFP_KERNEL);
+	u8 output[16];
+	unsigned int out_size;
+	int ret;
+
+	KUNIT_ASSERT_NOT_NULL(test, state);
+	KUNIT_ASSERT_NOT_NULL(test, window);
+	memset(window, 0x5a, 2 * PAGE_SIZE);
+
+	for (out_size = 0; out_size < ARRAY_SIZE(output); out_size++) {
+		unsigned int i;
+
+		memset(output, 0xa5, sizeof(output));
+		ret = crystal_lz4kd_encode_delta(state, window,
+				window + PAGE_SIZE, output, PAGE_SIZE, out_size,
+				out_size);
+		KUNIT_EXPECT_LE(test, ret, 0);
+		for (i = out_size; i < ARRAY_SIZE(output); i++)
+			KUNIT_EXPECT_EQ(test, output[i], (u8)0xa5);
+	}
+}
+
+static struct kunit_case zram_sddc_codec_test_cases[] = {
+	KUNIT_CASE(zram_sddc_codec_roundtrip_test),
+	KUNIT_CASE(zram_sddc_codec_raw_contract_test),
+	KUNIT_CASE(zram_sddc_codec_delta_chain_test),
+	KUNIT_CASE(zram_sddc_codec_full_window_test),
+	KUNIT_CASE(zram_sddc_codec_malformed_test),
+	KUNIT_CASE(zram_sddc_codec_delta_output_bounds_test),
+	{}
+};
+
+static struct kunit_suite zram_sddc_codec_test_suite = {
+	.name = "zram-sddc-codec",
+	.init = zram_sddc_codec_test_init,
+	.exit = zram_sddc_codec_test_exit,
+	.test_cases = zram_sddc_codec_test_cases,
+};
+
+kunit_test_suite(zram_sddc_codec_test_suite);
diff --git a/drivers/block/zram/sddc/lz4kd/lz4kd.h b/drivers/block/zram/sddc/lz4kd/lz4kd.h
new file mode 100644
--- /dev/null
+++ b/drivers/block/zram/sddc/lz4kd/lz4kd.h
@@ -0,0 +1,250 @@
+// SPDX-License-Identifier: BSD-3-Clause OR GPL-2.0
