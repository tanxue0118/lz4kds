+static inline bool zram_sddc_slot_managed_locked(struct zram *zram,
+		u32 index)
+{
+	return false;
+}
+
+static inline bool zram_sddc_accounted_size_locked(struct zram *zram,
+		u32 index, size_t *size)
+{
+	return false;
+}
+
+static inline void zram_sddc_snapshot_locked(struct zram *zram, u32 index,
+		struct zram_sddc_snapshot *snapshot)
+{
+	memset(snapshot, 0, sizeof(*snapshot));
+}
+
+static inline bool zram_sddc_snapshot_matches_locked(struct zram *zram,
+		u32 index, const struct zram_sddc_snapshot *snapshot)
+{
+	return true;
+}
+
+static inline int zram_sddc_read_page(struct zram *zram,
+		struct page *page, u32 index)
+{
+	return -EAGAIN;
+}
+
+static inline int zram_sddc_flatten(struct zram *zram, u32 index,
+		const struct zram_sddc_snapshot *snapshot, void *dst,
+		size_t *size)
+{
+	return -EOPNOTSUPP;
+}
+
+static inline void zram_sddc_get_stats(struct zram *zram,
+		struct zram_sddc_stats_snapshot *stats)
