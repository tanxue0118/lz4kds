+	struct zram_sddc_ref ref = {
+		.sddc = &ctx->sddc,
+		.cookie = { .id = 23, .generation = 11 },
+	};
+	struct zram_sddc_cookie stale = ref.cookie;
+	struct zram_sddc_ref *pinned;
+	int ret;
+
+	refcount_set(&ref.refs, 1);
+	ret = xa_reserve(&ctx->sddc.refs, ref.cookie.id, GFP_KERNEL);
+	KUNIT_ASSERT_EQ(test, ret, 0);
+	KUNIT_ASSERT_TRUE(test,
+			zram_sddc_ref_publish(&ctx->sddc, &ref));
+
+	stale.generation++;
+	KUNIT_EXPECT_NULL(test, zram_sddc_ref_pin(&ctx->sddc, &stale));
+	KUNIT_EXPECT_EQ(test, refcount_read(&ref.refs), 1U);
+
+	pinned = zram_sddc_ref_pin(&ctx->sddc, &ref.cookie);
+	KUNIT_ASSERT_PTR_EQ(test, pinned, &ref);
+	KUNIT_EXPECT_EQ(test, refcount_read(&ref.refs), 2U);
+	zram_sddc_ref_put(pinned);
+	KUNIT_EXPECT_EQ(test, refcount_read(&ref.refs), 1U);
+	xa_erase(&ctx->sddc.refs, ref.cookie.id);
+}
