+static void zram_sddc_sparse_reservation_test(struct kunit *test)
+{
+	struct zram_sddc_test_ctx *ctx = test->priv;
+	struct zram_sddc_slot_state *state;
+	struct zram_sddc_snapshot snapshot;
+	u64 reservation_seq = 73;
+
+	ctx->mutation_seq[0] = reservation_seq;
+	KUNIT_ASSERT_TRUE(test, xa_empty(&ctx->sddc.slot_states));
+	zram_sddc_slot_lock(&ctx->zram, 0);
+	zram_sddc_snapshot_locked(&ctx->zram, 0, &snapshot);
+	zram_sddc_slot_unlock(&ctx->zram, 0);
+	KUNIT_EXPECT_EQ(test, snapshot.mutation_seq, (u64)73);
+	KUNIT_EXPECT_EQ(test, snapshot.kind, (u8)ZRAM_SDDC_NONE);
+
+	state = zram_sddc_state_prepare(&ctx->sddc, 0);
+	KUNIT_ASSERT_NOT_NULL(test, state);
+	KUNIT_EXPECT_FALSE(test, xa_empty(&ctx->sddc.slot_states));
+	KUNIT_EXPECT_NULL(test, xa_load(&ctx->sddc.slot_states, 0));
+	zram_sddc_slot_lock(&ctx->zram, 0);
+	KUNIT_EXPECT_EQ(test,
+		zram_sddc_slot_free_locked(&ctx->zram, 0),
+		ZRAM_SDDC_NONE);
+	zram_sddc_slot_unlock(&ctx->zram, 0);
+	/* A free must leave an in-flight reservation for its owner to abort;
+	 * otherwise a later conversion could reuse it. */
+	KUNIT_EXPECT_FALSE(test, xa_empty(&ctx->sddc.slot_states));
+	KUNIT_EXPECT_TRUE(test, zram_sddc_state_identity_changed(&ctx->sddc,
+			0, reservation_seq));
+	zram_sddc_state_abort(&ctx->sddc, 0, reservation_seq, state);
+	KUNIT_EXPECT_TRUE(test, xa_empty(&ctx->sddc.slot_states));
+}
+
+static void zram_sddc_reservation_job_test(struct kunit *test)
+{
+	struct zram_sddc_test_ctx *ctx = test->priv;
+	struct zram_sddc_slot_state *state;
+	struct zram_sddc_job_key key = {
+		.index = 0,
+		.mutation_seq = 91,
+		.handle = 0x4321,
+		.size = 512,
+		.prio = ZRAM_PRIMARY_COMP,
+	};
+
+	ctx->mutation_seq[0] = key.mutation_seq;
+	ctx->table[0].handle = key.handle;
+	zram_sddc_set_obj_size(&ctx->zram, 0, key.size);
+	state = zram_sddc_state_prepare(&ctx->sddc, key.index);
+	KUNIT_ASSERT_NOT_NULL(test, state);
+
+	zram_sddc_slot_lock(&ctx->zram, key.index);
+	KUNIT_EXPECT_FALSE(test,
+			zram_sddc_job_matches_locked(&ctx->sddc, &key, false));
+	KUNIT_EXPECT_TRUE(test,
+			zram_sddc_job_matches_locked(&ctx->sddc, &key, true));
+	zram_sddc_slot_unlock(&ctx->zram, key.index);
+	KUNIT_EXPECT_FALSE(test, zram_sddc_state_identity_changed(&ctx->sddc,
+			key.index, key.mutation_seq));
+
+	zram_sddc_state_abort(&ctx->sddc, key.index, key.mutation_seq, state);
+}
