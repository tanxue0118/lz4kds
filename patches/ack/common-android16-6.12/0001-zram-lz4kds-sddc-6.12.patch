diff --git a/drivers/block/zram/backend_lz4kds.c b/drivers/block/zram/backend_lz4kds.c
new file mode 100644
--- /dev/null
+++ b/drivers/block/zram/backend_lz4kds.c
@@ -0,0 +1,157 @@
+// SPDX-License-Identifier: GPL-2.0-or-later
+
+#include <linux/kernel.h>
+#include <linux/err.h>
+
+#include "backend_lz4kds.h"
+
+#if IS_ENABLED(CONFIG_ZRAM_SDDC)
+
+#include "sddc/zram_sddc_codec.h"
+
+/*
+ * LZ4KDS/SDDC backend glue.
+ *
+ * The heavy lifting lives in the sddc codec (drivers/block/zram/sddc); this
+ * file only maps the generic struct zcomp_ops contract onto the codec calls.
+ * One codec instance is created per per-CPU execution context and stashed in
+ * ctx->context, mirroring the lifetime rules of the other backends (create_ctx
+ * on CPU up, destroy_ctx on CPU down / tear down).
+ */
+
+/*
+ * lz4kds takes neither a dictionary nor a level: the encoder state is fixed
+ * size and the algorithm has no tunables. setup_params() still has to run so
+ * that a stale level coming from sysfs ("algorithm_params") cannot leak into
+ * the codec, and so that the SHOW path reports a sane value.
+ */
+static int lz4kds_setup_params(struct zcomp_params *params)
+{
+	params->level = 0;
+
+	return 0;
+}
+
+static void lz4kds_release_params(struct zcomp_params *params)
+{
+}
+
+static int lz4kds_create(struct zcomp_params *params, struct zcomp_ctx *ctx)
+{
+	struct zram_sddc_codec *codec;
+
+	codec = zram_sddc_codec_create();
+	if (IS_ERR(codec)) {
+		ctx->context = NULL;
+		return PTR_ERR(codec);
+	}
+
+	ctx->context = codec;
+	return 0;
+}
+
+static void lz4kds_destroy(struct zcomp_ctx *ctx)
+{
+	zram_sddc_codec_destroy(ctx->context);
+	ctx->context = NULL;
+}
+
+static struct zram_sddc_codec *lz4kds_codec(struct zcomp_ctx *ctx)
+{
+	return ctx->context;
+}
+
+/*
+ * struct zcomp_req carries dst_len as size_t while the codec speaks
+ * unsigned int. Convert through a local, then write back so that callers
+ * observe the produced length in req->dst_len as usual.
+ */
+static int lz4kds_compress(struct zcomp_params *params, struct zcomp_ctx *ctx,
+			   struct zcomp_req *req)
+{
+	unsigned int dst_len = req->dst_len;
+	int ret;
+
+	ret = zram_sddc_codec_compress(lz4kds_codec(ctx), req->src, req->src_len,
+				       req->dst, &dst_len);
+	if (ret)
+		return ret;
+
+	req->dst_len = dst_len;
+	return 0;
+}
+
+static int lz4kds_decompress(struct zcomp_params *params, struct zcomp_ctx *ctx,
+			     struct zcomp_req *req)
+{
+	unsigned int dst_len = req->dst_len;
+	int ret;
+
+	ret = zram_sddc_codec_decompress(lz4kds_codec(ctx), req->src,
+					 req->src_len, req->dst, &dst_len);
+	if (ret)
+		return ret;
+
+	req->dst_len = dst_len;
+	return 0;
+}
+
+static int lz4kds_compress_delta(struct zcomp_params *params,
+				 struct zcomp_ctx *ctx,
+				 const void *ref, unsigned int ref_len,
+				 const void *src, unsigned int src_len,
+				 void *dst, unsigned int *dst_len,
+				 unsigned int out_limit)
+{
+	return zram_sddc_codec_compress_delta(lz4kds_codec(ctx), ref, ref_len,
+					      src, src_len, dst, dst_len,
+					      out_limit);
+}
+
+static int lz4kds_decompress_delta(struct zcomp_params *params,
+				   struct zcomp_ctx *ctx,
+				   const void *src, unsigned int src_len,
+				   const void *ref, unsigned int ref_len,
+				   void *dst, unsigned int *dst_len)
+{
+	return zram_sddc_codec_decompress_delta(lz4kds_codec(ctx), src, src_len,
+						ref, ref_len, dst, dst_len);
+}
+
+static int lz4kds_decompress_delta_borrowed(struct zcomp_params *params,
+					    struct zcomp_ctx *ctx,
+					    const void *src, unsigned int src_len,
+					    const void *ref, unsigned int ref_len,
+					    const void **restored,
+					    unsigned int *restored_len)
+{
+	return zram_sddc_codec_decompress_delta_borrowed(lz4kds_codec(ctx), src,
+							 src_len, ref, ref_len,
+							 restored,
+							 restored_len);
+}
+
+const struct zcomp_ops backend_lz4kds = {
+	.compress			= lz4kds_compress,
+	.decompress			= lz4kds_decompress,
+	.create_ctx			= lz4kds_create,
+	.destroy_ctx			= lz4kds_destroy,
+	.setup_params			= lz4kds_setup_params,
+	.release_params			= lz4kds_release_params,
+	.compress_delta			= lz4kds_compress_delta,
+	.decompress_delta		= lz4kds_decompress_delta,
+	.decompress_delta_borrowed	= lz4kds_decompress_delta_borrowed,
+	.name				= "lz4kds",
+};
+
+#else /* !CONFIG_ZRAM_SDDC */
+
+/*
+ * Empty compilation unit guard: backend_lz4kds.o is only linked when
+ * CONFIG_ZRAM_SDDC is on, but an unconditional reference from zcomp.c must
+ * still be able to see a definition-less header, and this keeps the object
+ * non-empty should the Makefile ever build it unconditionally.
+ */
+int backend_lz4kds_unused;
+
+#endif /* CONFIG_ZRAM_SDDC */
