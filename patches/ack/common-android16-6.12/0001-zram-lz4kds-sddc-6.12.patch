+static int zram_sddc_state_test_init(struct kunit *test)
+{
+	struct zram_sddc_test_ctx *ctx;
+	unsigned int i;
+
+	ctx = kunit_kzalloc(test, sizeof(*ctx), GFP_KERNEL);
+	if (!ctx)
+		return -ENOMEM;
+
+	ctx->zram.table = ctx->table;
+	/* 6.12 keeps a real spinlock_t per table entry; the bit spinlock the
+	 * 6.6 code relied on was implicitly initialized by a zeroed flags word. */
+	for (i = 0; i < ZRAM_SDDC_TEST_SLOTS; i++)
