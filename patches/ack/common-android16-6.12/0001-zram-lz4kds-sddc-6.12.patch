+static void zram_sddc_snapshot_identity_test(struct kunit *test)
+{
+	struct zram_sddc_test_ctx *ctx = test->priv;
+	struct zram_sddc_slot_state *state;
+	struct zram_sddc_snapshot snapshot;
+
+	ctx->mutation_seq[0] = 41;
+	state = zram_sddc_test_install_state(ctx, 0,
+			ZRAM_SDDC_DELTA);
+	KUNIT_ASSERT_NOT_NULL(test, state);
+	state->ref.id = 9;
+	state->ref.generation = 3;
+	zram_sddc_slot_lock(&ctx->zram, 0);
+	zram_sddc_snapshot_locked(&ctx->zram, 0, &snapshot);
+	zram_sddc_slot_unlock(&ctx->zram, 0);
+	KUNIT_ASSERT_TRUE(test,
+			zram_sddc_test_snapshot_matches(ctx, 0, &snapshot));
+
+	ctx->mutation_seq[0]++;
+	KUNIT_EXPECT_FALSE(test,
+			zram_sddc_test_snapshot_matches(ctx, 0, &snapshot));
+	ctx->mutation_seq[0] = snapshot.mutation_seq;
+	state->kind = ZRAM_SDDC_ALIAS;
+	KUNIT_EXPECT_FALSE(test,
+			zram_sddc_test_snapshot_matches(ctx, 0, &snapshot));
+	state->kind = snapshot.kind;
+	state->ref.generation++;
+	KUNIT_EXPECT_FALSE(test,
+			zram_sddc_test_snapshot_matches(ctx, 0, &snapshot));
+	state->ref = snapshot.ref;
+	state->ref.id++;
+	KUNIT_EXPECT_FALSE(test,
+			zram_sddc_test_snapshot_matches(ctx, 0, &snapshot));
+	state->ref = snapshot.ref;
+	KUNIT_EXPECT_TRUE(test,
+			zram_sddc_test_snapshot_matches(ctx, 0, &snapshot));
+}
