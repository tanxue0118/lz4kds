 static int zcomp_strm_init(struct zcomp *comp, struct zcomp_strm *zstrm)
 {
 	int ret;
+
+	/*
+	 * The delta entry points only get the per-CPU stream, so the owning
+	 * comp has to be reachable from it. Set before any call that may end
+	 * up in zcomp_strm_free().
+	 */
+	zstrm->comp = comp;
 
 	ret = comp->ops->create_ctx(comp->params, &zstrm->ctx);
 	if (ret)
@@ -150,6 +165,91 @@
 	return comp->ops->decompress(comp->params, &zstrm->ctx, &req);
 }
 
+bool zcomp_supports_delta(const struct zcomp *comp)
+{
+	return comp && comp->ops && comp->ops->compress_delta &&
+		comp->ops->decompress_delta;
+}
+
+/*
+ * Delta variants.
+ *
+ * Unlike zcomp_compress()/zcomp_decompress(), callers of these only hold a
+ * per-CPU stream (they got it from zcomp_stream_get() and did not keep the
+ * comp around), so the owning comp is read back from zstrm->comp - filled in
+ * by zcomp_strm_init(). ops/params are taken from it and the scratch buffer is
+ * the stream's own 2-page ->buffer, same as the non-delta paths.
+ */
+int zcomp_compress_delta(struct zcomp_strm *zstrm, const void *ref,
+			 unsigned int ref_len, const void *src,
+			 unsigned int src_len, unsigned int *dst_len,
+			 unsigned int out_limit)
+{
+	const struct zcomp *comp = zstrm->comp;
+
+	if (!comp || !comp->ops->compress_delta)
+		return -EOPNOTSUPP;
+	if (!dst_len || !zstrm->buffer)
+		return -EINVAL;
+
+	*dst_len = 2 * PAGE_SIZE;
+	return comp->ops->compress_delta(comp->params, &zstrm->ctx, ref, ref_len,
+					 src, src_len, zstrm->buffer, dst_len,
+					 out_limit);
+}
+
+int zcomp_decompress_delta(struct zcomp_strm *zstrm, const void *src,
+			   unsigned int src_len, const void *ref,
+			   unsigned int ref_len, void *dst,
+			   unsigned int *dst_len)
+{
+	const struct zcomp *comp = zstrm->comp;
+
+	if (!comp || !comp->ops->decompress_delta)
+		return -EOPNOTSUPP;
+	if (!dst || !dst_len)
+		return -EINVAL;
+
+	*dst_len = PAGE_SIZE;
+	return comp->ops->decompress_delta(comp->params, &zstrm->ctx, src,
+					   src_len, ref, ref_len, dst, dst_len);
+}
+
+/*
+ * Same as zcomp_decompress_delta() but the backend may hand back its own
+ * per-CPU window instead of copying into zstrm->buffer. When the backend has
+ * no such callback we degrade to the copying path and point *restored at the
+ * stream buffer.
+ */
+int zcomp_decompress_delta_borrowed(struct zcomp_strm *zstrm, const void *src,
+				    unsigned int src_len, const void *ref,
+				    unsigned int ref_len, const void **restored,
+				    unsigned int *restored_len)
+{
+	const struct zcomp *comp = zstrm->comp;
+	int ret;
+
+	if (!restored || !restored_len)
+		return -EINVAL;
+
+	*restored = NULL;
+	*restored_len = PAGE_SIZE;
+
+	if (!comp || !comp->ops->decompress_delta)
+		return -EOPNOTSUPP;
+
+	if (comp->ops->decompress_delta_borrowed)
+		return comp->ops->decompress_delta_borrowed(comp->params,
+				&zstrm->ctx, src, src_len, ref, ref_len,
+				restored, restored_len);
+
+	ret = zcomp_decompress_delta(zstrm, src, src_len, ref, ref_len,
+				     zstrm->buffer, restored_len);
+	if (!ret)
+		*restored = zstrm->buffer;
+	return ret;
+}
