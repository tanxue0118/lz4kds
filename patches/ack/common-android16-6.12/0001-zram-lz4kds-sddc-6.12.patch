+static void zram_sddc_index_quality_test(struct kunit *test)
+{
+	struct zram_sddc_ref ref = { };
+
+	refcount_set(&ref.refs, 3);
+	KUNIT_EXPECT_EQ(test, zram_sddc_ref_count_without_pin(&ref), 2U);
+	refcount_set(&ref.refs, 1);
+	KUNIT_EXPECT_EQ(test, zram_sddc_ref_count_without_pin(&ref), 0U);
+
+	/* Lower reference count and smaller payloads are the first eviction
+	 * candidates; a highly shared reference survives an exact tie. */
+	KUNIT_EXPECT_TRUE(test,
+		zram_sddc_index_candidate_worse(4, 512, 3, 1024));
+	KUNIT_EXPECT_FALSE(test,
+		zram_sddc_index_candidate_worse(3, 512, 4, 256));
+	KUNIT_EXPECT_TRUE(test,
+		zram_sddc_index_candidate_worse(3, 512, 3, 256));
+	KUNIT_EXPECT_FALSE(test,
+		zram_sddc_index_candidate_worse(3, 512, 3, 1024));
+	KUNIT_EXPECT_FALSE(test,
+		zram_sddc_index_candidate_worse(3, 512, 3, 512));
+	KUNIT_EXPECT_TRUE(test,
+		zram_sddc_index_candidate_worse(2, 512, 2, 512));
+}
