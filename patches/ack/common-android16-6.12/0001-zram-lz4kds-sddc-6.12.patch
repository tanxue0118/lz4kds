+static void zram_sddc_stale_job_key_test(struct kunit *test)
+{
+	struct zram_sddc_test_ctx *ctx = test->priv;
+	struct zram_sddc_job_key key = {
+		.mutation_seq = 19,
+		.handle = 0x1234,
+		.index = 0,
+		.size = 512,
+		.prio = ZRAM_PRIMARY_COMP,
+	};
+
+	ctx->mutation_seq[0] = key.mutation_seq;
+	ctx->table[0].handle = key.handle;
+	zram_sddc_set_obj_size(&ctx->zram, 0, key.size);
+	KUNIT_ASSERT_TRUE(test, zram_sddc_test_job_matches(ctx, &key));
+
+	ctx->mutation_seq[0]++;
+	KUNIT_EXPECT_FALSE(test, zram_sddc_test_job_matches(ctx, &key));
+	ctx->mutation_seq[0] = key.mutation_seq;
+	ctx->table[0].handle++;
+	KUNIT_EXPECT_FALSE(test, zram_sddc_test_job_matches(ctx, &key));
+	ctx->table[0].handle = key.handle;
+	KUNIT_ASSERT_NOT_NULL(test, zram_sddc_test_install_state(ctx,
+			0, ZRAM_SDDC_ALIAS));
+	KUNIT_EXPECT_FALSE(test, zram_sddc_test_job_matches(ctx, &key));
