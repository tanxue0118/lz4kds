new file mode 100644
--- /dev/null
+++ b/drivers/block/zram/sddc/zram_sddc.c
@@ -0,0 +1,3118 @@
+// SPDX-License-Identifier: GPL-2.0-or-later
+
+#include <linux/atomic.h>
+#include <linux/bitmap.h>
+#include <linux/blkdev.h>
+#include <linux/byteorder/generic.h>
+#include <linux/highmem.h>
+#include <linux/idr.h>
+#include <linux/jhash.h>
+#include <linux/mm.h>
+#include <linux/refcount.h>
+#include <linux/slab.h>
+#include <linux/sort.h>
+#include <linux/spinlock.h>
+#include <linux/vmalloc.h>
+#include <linux/wait.h>
+#include <linux/workqueue.h>
+#include <linux/xarray.h>
+#include <linux/zsmalloc.h>
+
+#if IS_ENABLED(CONFIG_ZRAM_SDDC_KUNIT_TEST)
+#include <kunit/test.h>
+#endif
+
+#include "../zram_drv.h"
+#include "zram_sddc.h"
+
+#define ZRAM_SDDC_HASH_BITS		16
+#define ZRAM_SDDC_HASH_BUCKETS	(1U << ZRAM_SDDC_HASH_BITS)
+#define ZRAM_SDDC_BUCKET_WAYS	8
+#define ZRAM_SDDC_SAMPLE_SIZE	16
+#define ZRAM_SDDC_INDEX_MIN_SIZE	256
+#define ZRAM_SDDC_OBSERVE_WORKS	2
+#define ZRAM_SDDC_MAX_SLOTS	(UINT_MAX - (BITS_PER_LONG - 1))
+#define ZRAM_SDDC_HASH_SEED		0x1e35a7bdU
+#define ZRAM_SDDC_DELTA_GAIN_MIN	8
+#define ZRAM_SDDC_DELTA_MIN_SIZE	(PAGE_SIZE / 8)
+#define ZRAM_SDDC_SIMILARITY_MIN	16
+#define ZRAM_SDDC_DELTA_MAGIC	0x43444453U
+#define ZRAM_SDDC_DELTA_VERSION	1
+#define ZRAM_SDDC_OBSERVE_BUDGET	64
+
+enum zram_sddc_sample_kind {
+	ZRAM_SDDC_SAMPLE_HEAD = BIT(0),
+	ZRAM_SDDC_SAMPLE_TAIL = BIT(1),
+};
+
+struct zram_sddc_slot_state {
+	struct zram_sddc_cookie ref;
+	u32 accounted_size;
+	u32 saved_size;
+	u8 kind;
+};
+
+struct zram_sddc_delta_header {
+	__le32 magic;
+	__le16 version;
+	__le16 header_size;
+	__le32 ref_id;
+	__le32 ref_generation;
+	__le32 ref_size;
+	__le32 target_size;
+};
+
+struct zram_sddc_workspace {
+	void *ordinary;
+	void *ref_data;
+	void *wire;
+};
+
+struct zram_sddc_candidate {
+	u32 index;
+	u8 sample_kind;
+};
+
+struct zram_sddc_bucket {
+	/* Zero is empty; non-zero stores slot index + 1.  Keeping the index
+	 * compact leaves room for the Huawei-sized candidate tables without
+	 * giving up the generation checks in the managed state. */
+	u32 cells[ZRAM_SDDC_BUCKET_WAYS];
+	u8 next;
+};
+
+struct zram_sddc_ranked_candidate {
+	struct zram_sddc_candidate candidate;
+	u32 match_bytes;
+	u32 ref_count;
+	u32 source_size;
+};
+
+struct zram_sddc;
+
+/* A second work item lets the drain continue while the first callback is
+ * still returning from the workqueue.
+ */
+struct zram_sddc_observe_work {
+	struct work_struct work;
+	struct zram_sddc *sddc;
+	unsigned int id;
+};
+
+struct zram_sddc_stats {
+	atomic64_t queued;
+	atomic64_t coalesced;
+	atomic64_t dropped;
+	atomic64_t ineligible;
+	atomic64_t shutdown_discarded;
+	atomic64_t worker_runs;
+	atomic64_t observed;
+	atomic64_t stale;
+	atomic64_t indexed;
+	atomic64_t refs;
+	atomic64_t ref_bytes;
+	atomic64_t aliases;
+	atomic64_t deltas;
+	atomic64_t delta_bytes;
+	atomic64_t alias_attempts;
+	atomic64_t alias_hits;
+	atomic64_t delta_attempts;
+	atomic64_t delta_hits;
+	atomic64_t delta_matches;
+	atomic64_t delta_small_rejects;
+	atomic64_t delta_no_gain;
+	atomic64_t delta_match_bytes_max;
+	atomic64_t saved_bytes;
+	atomic64_t saved_bytes_total;
+	atomic64_t conversion_failures;
+	atomic64_t decode_failures;
+	atomic64_t flatten_failures;
+	atomic64_t limit_rejects;
+	atomic64_t pending_max;
+};
+
+struct zram_sddc_ref {
+	struct work_struct free_work;
+	struct zram_sddc *sddc;
+	refcount_t refs;
+	struct zram_sddc_cookie cookie;
+	unsigned long handle;
+		u32 size;
+	u8 prio;
+};
+
+struct zram_sddc {
+	struct zram *zram;
+	u64 *mutation_seq;
+	struct xarray slot_states;
+	struct zram_sddc_bucket *exact_index;
+	struct zram_sddc_bucket *sample_index;
+	struct workqueue_struct *workqueue;
+	struct workqueue_struct *free_workqueue;
+	struct zram_sddc_observe_work observe_work[ZRAM_SDDC_OBSERVE_WORKS];
+	struct zram_sddc_workspace *observe_workspace;
+	unsigned long *observe_pending;
+	unsigned long nr_slots;
+	spinlock_t state_lock;
+	spinlock_t index_lock;
+	spinlock_t active_lock;
+	struct ida ref_ids;
+	struct xarray refs;
+	atomic_t next_generation;
+	atomic_t active_ops;
+	wait_queue_head_t active_wait;
+	unsigned long observe_cursor;
+	unsigned int observe_work_cursor;
+	unsigned int pending;
+	bool observe_worker_active;
+	bool stopping;
+	struct zram_sddc_stats stats;
+};
+
+struct zram_sddc_source {
+	struct zram_sddc_job_key key;
+	struct zram_sddc_cookie cookie;
+	struct zram_sddc_ref *ref;
+	bool ordinary;
+};
+
+static size_t zram_sddc_obj_size(struct zram *zram, u32 index)
+{
+	return zram->table[index].flags & (BIT(ZRAM_FLAG_SHIFT) - 1);
+}
+
+static u32 zram_sddc_priority(struct zram *zram, u32 index)
+{
+	u32 prio = zram->table[index].flags >> ZRAM_COMP_PRIORITY_BIT1;
+
+	return prio & ZRAM_COMP_PRIORITY_MASK;
+}
+
+static void zram_sddc_set_obj_size(struct zram *zram, u32 index,
+		size_t size)
+{
+	unsigned long flags = zram->table[index].flags >> ZRAM_FLAG_SHIFT;
+
+	zram->table[index].flags = (flags << ZRAM_FLAG_SHIFT) | size;
+}
+
+static bool zram_sddc_test_flag(struct zram *zram, u32 index,
+		enum zram_pageflags flag)
+{
+	return zram->table[index].flags & BIT(flag);
+}
+
+static void zram_sddc_clear_storage_flags(struct zram *zram, u32 index)
+{
+	if (zram_sddc_test_flag(zram, index, ZRAM_HUGE)) {
+		zram->table[index].flags &= ~BIT(ZRAM_HUGE);
+		atomic64_dec(&zram->stats.huge_pages);
+	}
+	if (zram_sddc_test_flag(zram, index, ZRAM_INCOMPRESSIBLE))
+		zram->table[index].flags &= ~BIT(ZRAM_INCOMPRESSIBLE);
+}
+
+/*
+ * 6.12 stores a real spinlock_t in struct zram_table_entry and serializes the
+ * slot through zram_drv.c's zram_slot_lock().  Take the same lock here so the
+ * manager and the driver exclude each other; the "_locked" suffix on the
+ * helpers below keeps meaning "the caller already holds this lock".
+ */
+static void zram_sddc_slot_lock(struct zram *zram, u32 index)
+{
+	spin_lock(&zram->table[index].lock);
+}
+
+static void zram_sddc_slot_unlock(struct zram *zram, u32 index)
+{
+	spin_unlock(&zram->table[index].lock);
+}
+
+static bool zram_sddc_memory_limit_ok(struct zram *zram)
+{
+	unsigned long pages = zs_get_total_pages(zram->mem_pool);
+	long old = atomic_long_read(&zram->stats.max_used_pages);
+
+	while (pages > old) {
+		long previous = atomic_long_cmpxchg(&zram->stats.max_used_pages,
+				old, pages);
+
+		if (previous == old)
+			break;
+		old = previous;
+	}
+	return !zram->limit_pages || pages <= zram->limit_pages;
+}
+
+static bool zram_sddc_cookie_equal(const struct zram_sddc_cookie *a,
+		const struct zram_sddc_cookie *b)
+{
+	return a->id == b->id && a->generation == b->generation;
+}
+
+/* The caller holds the corresponding zram slot lock. */
+static struct zram_sddc_slot_state *
+zram_sddc_state_load_locked(struct zram_sddc *sddc, u32 index)
+{
+	struct zram_sddc_slot_state *state;
+
+	state = xa_load(&sddc->slot_states, index);
+	if (!state || xa_is_err(state) || xa_is_zero(state))
+		return NULL;
+	return state;
+}
+
+/* Unlike xa_load(), this preserves XA_ZERO_ENTRY so a slot free cannot
+ * accidentally consume a reservation belonging to an in-flight conversion. */
+static void *zram_sddc_state_load_raw(struct zram_sddc *sddc,
+		u32 index)
+{
+	XA_STATE(xas, &sddc->slot_states, index);
+	unsigned long flags;
+	void *entry;
+
+	xa_lock_irqsave(&sddc->slot_states, flags);
+	entry = xas_load(&xas);
+	xa_unlock_irqrestore(&sddc->slot_states, flags);
+	return entry;
+}
+
+/*
+ * Release an XArray reservation without treating a concurrent state as ours.
+ * The normal xa_* API hides XA_ZERO_ENTRY, so use the advanced API while
+ * holding the array lock and make the test-and-release one operation.
+ */
+static bool zram_sddc_xa_release_reservation(struct xarray *xa,
+		unsigned long index)
+{
+	XA_STATE(xas, xa, index);
+	unsigned long flags;
+	bool released = false;
+
+	xa_lock_irqsave(xa, flags);
+	if (xas_load(&xas) == XA_ZERO_ENTRY) {
+		xas_store(&xas, NULL);
+		released = !xas_error(&xas);
+	}
+	xa_unlock_irqrestore(xa, flags);
+
+	return released;
+}
+
+/* Remove an XArray entry only if it is still the value observed by the
+ * caller.  Slot locks do not cover the reservation abort path, so a plain
+ * xa_erase() after a raw load could otherwise remove a newer state owner. */
+static void *zram_sddc_xa_erase_if(struct xarray *xa,
+		unsigned long index, void *expected)
+{
+	XA_STATE(xas, xa, index);
+	unsigned long flags;
+	void *removed = NULL;
+
+	if (!expected)
+		return NULL;
+
+	xa_lock_irqsave(xa, flags);
+	if (xas_load(&xas) == expected) {
+		xas_store(&xas, NULL);
+		if (!xas_error(&xas))
+			removed = expected;
+	}
+	xa_unlock_irqrestore(xa, flags);
+
+	return removed;
+}
+
+static struct zram_sddc_slot_state *
+zram_sddc_state_prepare(struct zram_sddc *sddc, u32 index)
+{
+	struct zram_sddc_slot_state *state;
+	int ret;
+
+	state = kzalloc(sizeof(*state), GFP_NOIO | __GFP_NOWARN);
+	if (!state)
+		return NULL;
+
+	/* xa_insert(NULL) conditionally creates XA_ZERO_ENTRY and reports
+	 * -EBUSY if another state or reservation already owns this slot. */
+	ret = xa_insert(&sddc->slot_states, index, NULL,
+			GFP_NOIO | __GFP_NOWARN);
+	if (ret) {
+		kfree(state);
+		return NULL;
+	}
+
+	return state;
+}
+
+static bool zram_sddc_state_identity_changed(
+		struct zram_sddc *sddc, u32 index, u64 mutation_seq)
+{
+	struct zram *zram = sddc->zram;
+	bool changed;
+
+	if (!zram || !READ_ONCE(zram->table) || index >= sddc->nr_slots)
+		return false;
+
+	zram_sddc_slot_lock(zram, index);
+	changed = sddc->mutation_seq[index] != mutation_seq;
+	zram_sddc_slot_unlock(zram, index);
+	return changed;
+}
+
+static void zram_sddc_state_abort(struct zram_sddc *sddc, u32 index,
+		u64 mutation_seq, struct zram_sddc_slot_state *state)
+{
+	void *entry;
+
+	if (!state)
+		return;
+
+	/* A failed publication leaves the reservation in place.  Do not erase a
+	 * state node (or a newer owner's reservation) if the caller is late. */
+	if (zram_sddc_xa_release_reservation(&sddc->slot_states, index)) {
+		/* A rewrite can observe our reservation and therefore cannot enqueue
+		 * its latest key.  Requeue only when the identity actually changed;
+		 * ordinary conversion rejection must not create a retry loop. */
+		bool identity_changed = zram_sddc_state_identity_changed(sddc,
+				index, mutation_seq);
+
+		kfree(state);
+		if (identity_changed && sddc->workqueue)
+			zram_sddc_requeue_observation(sddc->zram, index);
+		return;
+	}
+
+	entry = zram_sddc_state_load_raw(sddc, index);
+	if (entry == state) {
+		/* The caller must not abort a published value.  Keeping it alive is
+		 * safer than freeing memory still reachable from the XArray. */
+		WARN_ON_ONCE(1);
+		return;
+	}
+	/* A different owner may have won the slot after our reservation was
+	 * removed.  Our private object was never published and can be freed. */
+	if (entry && entry != XA_ZERO_ENTRY)
+		WARN_ON_ONCE(1);
+	kfree(state);
+}
+
+/* A prior xa_insert(NULL) makes this non-allocating under the slot lock. */
+static bool zram_sddc_state_install_locked(struct zram_sddc *sddc,
+		u32 index, struct zram_sddc_slot_state *state)
+{
+	XA_STATE(xas, &sddc->slot_states, index);
+	unsigned long flags;
+	bool installed = false;
+
+	if (WARN_ON_ONCE(!state))
+		return false;
+
+	/* Consume only our reservation; never overwrite a concurrent node. */
+	xa_lock_irqsave(&sddc->slot_states, flags);
+	if (xas_load(&xas) == XA_ZERO_ENTRY) {
+		xas_store(&xas, state);
+		installed = !xas_error(&xas);
+	}
+	xa_unlock_irqrestore(&sddc->slot_states, flags);
+
+	return installed;
+}
+
+static void zram_sddc_mutation_advance_locked(struct zram_sddc *sddc,
+		u32 index)
+{
+	if (!++sddc->mutation_seq[index])
+		sddc->mutation_seq[index]++;
+}
+
+static struct zram_sddc *zram_sddc_manager_get(struct zram *zram)
+{
+	struct zram_sddc *sddc;
+
+	spin_lock(&zram->sddc_lock);
+	sddc = zram->sddc;
+	if (!sddc || READ_ONCE(sddc->stopping))
+		sddc = NULL;
+	else {
+		spin_lock(&sddc->active_lock);
+		atomic_inc(&sddc->active_ops);
+		spin_unlock(&sddc->active_lock);
+	}
+	spin_unlock(&zram->sddc_lock);
+	return sddc;
+}
+
+static void zram_sddc_manager_put(struct zram_sddc *sddc)
+{
+	bool idle;
+
+	/* Keep the final decrement and wakeup inside active_lock.  Teardown
+	 * confirms idle while taking the same lock, so it cannot free @sddc while
+	 * this function is still touching its waitqueue. */
+	spin_lock(&sddc->active_lock);
+	idle = atomic_dec_and_test(&sddc->active_ops);
+	if (idle)
+		wake_up_all(&sddc->active_wait);
+	spin_unlock(&sddc->active_lock);
+}
+
+static void zram_sddc_manager_wait_idle(struct zram_sddc *sddc)
+{
+	for (;;) {
+		wait_event(sddc->active_wait,
+			!atomic_read(&sddc->active_ops));
+
+		/* A waiter may observe zero while the final put still owns
+		 * active_lock and is finishing wake_up_all(). */
+		spin_lock(&sddc->active_lock);
+		if (!atomic_read(&sddc->active_ops)) {
+			spin_unlock(&sddc->active_lock);
+			return;
+		}
+		spin_unlock(&sddc->active_lock);
+	}
+}
+
+static void zram_sddc_atomic64_update_max(atomic64_t *value, s64 candidate)
+{
+	s64 old = atomic64_read(value);
+
+	while (old < candidate) {
+		s64 previous = atomic64_cmpxchg(value, old, candidate);
+
+		if (previous == old)
+			break;
+		old = previous;
+	}
+}
+
+static struct zram_sddc_workspace *
+zram_sddc_workspace_alloc(gfp_t gfp_mask)
+{
+	struct zram_sddc_workspace *workspace;
+
+	workspace = kmalloc(sizeof(*workspace), gfp_mask);
+	if (!workspace)
+		return NULL;
+	workspace->ordinary = kmalloc(PAGE_SIZE, gfp_mask);
+	workspace->ref_data = kmalloc(PAGE_SIZE, gfp_mask);
+	workspace->wire = kmalloc(PAGE_SIZE, gfp_mask);
+	if (workspace->ordinary && workspace->ref_data && workspace->wire)
+		return workspace;
+
+	kfree(workspace->wire);
+	kfree(workspace->ref_data);
+	kfree(workspace->ordinary);
+	kfree(workspace);
+	return NULL;
+}
+
+static void zram_sddc_workspace_free(struct zram_sddc_workspace *workspace)
+{
+	if (!workspace)
+		return;
+	kfree(workspace->wire);
+	kfree(workspace->ref_data);
+	kfree(workspace->ordinary);
+	kfree(workspace);
+}
+
+static void zram_sddc_ref_release(struct zram_sddc_ref *ref)
+{
+	struct zram_sddc *sddc = ref->sddc;
+
+	zs_free(sddc->zram->mem_pool, ref->handle);
+	atomic64_sub(ref->size, &sddc->zram->stats.compr_data_size);
+	ida_free(&sddc->ref_ids, ref->cookie.id);
+	atomic64_dec(&sddc->stats.refs);
+	atomic64_sub(ref->size, &sddc->stats.ref_bytes);
+	kfree(ref);
+}
+
+static void zram_sddc_ref_free_workfn(struct work_struct *work)
+{
+	struct zram_sddc_ref *ref = container_of(work,
+			struct zram_sddc_ref, free_work);
+
+	zram_sddc_ref_release(ref);
+}
+
+static void zram_sddc_ref_queue_free(struct zram_sddc_ref *ref)
+{
+	WARN_ON_ONCE(!queue_work(ref->sddc->free_workqueue, &ref->free_work));
+}
+
+static struct zram_sddc_ref *
+zram_sddc_ref_alloc(struct zram_sddc *sddc)
+{
+	struct zram_sddc_ref *ref;
+	u32 generation;
+	int id;
+	int ret;
+
+	/* Conversion runs from a reclaim-capable workqueue.  Keep allocation
+	 * below the zram reclaim path and treat failure as an ordinary miss. */
+	ref = kzalloc(sizeof(*ref), GFP_NOIO | __GFP_NOWARN);
+	if (!ref)
+		return ERR_PTR(-ENOMEM);
+
+	id = ida_alloc_min(&sddc->ref_ids, 1, GFP_NOIO | __GFP_NOWARN);
+	if (id < 0) {
+		kfree(ref);
+		return ERR_PTR(id);
+	}
+
+	ret = xa_insert(&sddc->refs, id, NULL, GFP_NOIO | __GFP_NOWARN);
+	if (ret) {
+		ida_free(&sddc->ref_ids, id);
+		kfree(ref);
+		return ERR_PTR(ret);
+	}
+
+	generation = (u32)atomic_inc_return(&sddc->next_generation);
+	if (!generation)
+		generation = (u32)atomic_inc_return(&sddc->next_generation);
+
+	INIT_WORK(&ref->free_work, zram_sddc_ref_free_workfn);
+	ref->sddc = sddc;
+	ref->cookie.id = id;
+	ref->cookie.generation = generation;
+	return ref;
+}
+
+static void zram_sddc_ref_abort(struct zram_sddc_ref *ref)
+{
+	struct zram_sddc *sddc;
+
+	if (!ref)
+		return;
+	sddc = ref->sddc;
+	/* Only the allocator's reservation may be released here.  A failed
+	 * publication must never erase a newer entry reusing the same ID. */
+	if (WARN_ON_ONCE(!zram_sddc_xa_release_reservation(&sddc->refs,
+			ref->cookie.id)))
+		return;
+	ida_free(&sddc->ref_ids, ref->cookie.id);
+	kfree(ref);
+}
+
+static bool zram_sddc_ref_publish(struct zram_sddc *sddc,
+		struct zram_sddc_ref *ref)
+{
+	XA_STATE(xas, &sddc->refs, 0);
+	unsigned long flags;
+	bool published = false;
+
+	xas_set(&xas, ref->cookie.id);
+	xa_lock_irqsave(&sddc->refs, flags);
+	if (xas_load(&xas) == XA_ZERO_ENTRY) {
+		xas_store(&xas, ref);
+		published = !xas_error(&xas);
+	}
+	xa_unlock_irqrestore(&sddc->refs, flags);
+	return published;
+}
+
+static struct zram_sddc_ref *
+zram_sddc_ref_pin(struct zram_sddc *sddc,
+		const struct zram_sddc_cookie *cookie)
+{
+	struct zram_sddc_ref *ref;
+	unsigned long flags;
+
+	if (!cookie->id || !cookie->generation)
+		return NULL;
+
+	xa_lock_irqsave(&sddc->refs, flags);
+	ref = xa_load(&sddc->refs, cookie->id);
+	if (!ref || !zram_sddc_cookie_equal(&ref->cookie, cookie) ||
+	    !refcount_inc_not_zero(&ref->refs))
+		ref = NULL;
+	xa_unlock_irqrestore(&sddc->refs, flags);
+	return ref;
+}
+
+static void zram_sddc_ref_put(struct zram_sddc_ref *ref)
+{
+	struct zram_sddc *sddc;
+	unsigned long flags;
+	bool dead = false;
+
+	if (!ref)
+		return;
+	sddc = ref->sddc;
+
+	xa_lock_irqsave(&sddc->refs, flags);
+	if (refcount_dec_and_test(&ref->refs)) {
+		WARN_ON_ONCE(__xa_erase(&sddc->refs, ref->cookie.id) != ref);
+		dead = true;
+	}
+	xa_unlock_irqrestore(&sddc->refs, flags);
+
+	if (dead)
+		zram_sddc_ref_queue_free(ref);
+}
+
+/* ref_pin() contributes one temporary reference.  Index heuristics must
+ * compare the resident owner/consumer count, not the snapshot's pin. */
+static u32 zram_sddc_ref_count_without_pin(
+		const struct zram_sddc_ref *ref)
+{
+	u32 count = refcount_read(&ref->refs);
+
+	return count ? count - 1 : 0;
+}
+
+static void zram_sddc_ref_drop_cookie(struct zram_sddc *sddc,
+		const struct zram_sddc_cookie *cookie)
+{
+	struct zram_sddc_ref *ref;
+	unsigned long flags;
+	bool dead = false;
+
+	xa_lock_irqsave(&sddc->refs, flags);
+	ref = xa_load(&sddc->refs, cookie->id);
+	if (WARN_ON_ONCE(!ref ||
+			 !zram_sddc_cookie_equal(&ref->cookie, cookie))) {
+		xa_unlock_irqrestore(&sddc->refs, flags);
+		return;
+	}
+	if (refcount_dec_and_test(&ref->refs)) {
+		WARN_ON_ONCE(__xa_erase(&sddc->refs, ref->cookie.id) != ref);
+		dead = true;
+	}
+	xa_unlock_irqrestore(&sddc->refs, flags);
+
+	if (dead)
+		zram_sddc_ref_queue_free(ref);
+}
+
+static void zram_sddc_copy_ref(struct zram_sddc_ref *ref, void *dst)
+{
+	void *src;
+
+	src = zs_map_object(ref->sddc->zram->mem_pool, ref->handle, ZS_MM_RO);
+	memcpy(dst, src, ref->size);
+	zs_unmap_object(ref->sddc->zram->mem_pool, ref->handle);
+}
+
+static bool zram_sddc_job_matches_locked(struct zram_sddc *sddc,
+		const struct zram_sddc_job_key *key, bool own_reservation)
+{
+	struct zram *zram = sddc->zram;
+	void *state_entry;
+
+	if (key->index >= sddc->nr_slots)
+		return false;
+	if (sddc->mutation_seq[key->index] != key->mutation_seq)
+		return false;
+	state_entry = zram_sddc_state_load_raw(sddc, key->index);
+	/* A conversion reserves its target before taking this lock.  That
+	 * reservation is valid only for the caller which explicitly owns it;
+	 * ordinary observation validation must reject every reservation. */
+	if (own_reservation) {
+		if (state_entry != XA_ZERO_ENTRY)
+			return false;
+	} else if (state_entry) {
+		return false;
+	}
+	if (zram->table[key->index].handle != key->handle)
+		return false;
+	if (zram_sddc_obj_size(zram, key->index) != key->size)
+		return false;
+	if (zram_sddc_priority(zram, key->index) != key->prio)
+		return false;
+	if (!key->handle || key->size < ZRAM_SDDC_SAMPLE_SIZE ||
+	    key->size > PAGE_SIZE)
+		return false;
+	/*
+	 * 6.12 dropped ZRAM_UNDER_WB.  The 6.6 flag marked "a writeback bio is
+	 * in flight, its zs object is still owned by the slot".  That window is
+	 * already covered here: every caller of this helper holds the slot lock,
+	 * and both the writeback completion and the prefetch-cache reuse that
+	 * change the handle do so under the same lock, so the handle/size/prio
+	 * comparisons above cannot straddle the change.  On top of that
+	 * zram_sddc_commit_target() re-validates the job key before committing,
+	 * so a slot that changed underneath us is rejected, not converted.
+	 */
+	if (zram_sddc_test_flag(zram, key->index, ZRAM_SAME) ||
+	    zram_sddc_test_flag(zram, key->index, ZRAM_WB))
+		return false;
+
+	return key->prio == ZRAM_PRIMARY_COMP &&
+		zram->comps[key->prio] &&
+		zcomp_supports_delta(zram->comps[key->prio]);
+}
+
+static u32 zram_sddc_index_cell(u32 index)
+{
+	/* Slot zero is valid, so reserve zero as the empty marker. */
+	return index + 1;
+}
+
+static u32 zram_sddc_index_decode(u32 cell)
+{
+	return cell - 1;
+}
+
+static void zram_sddc_index_quality(struct zram_sddc *sddc,
+		u32 cell, u32 *ref_count, u32 *size)
+{
+	struct zram *zram = sddc->zram;
+	struct zram_sddc_slot_state *state;
+	struct zram_sddc_ref *ref = NULL;
+	void *entry;
+	u32 index;
+
+	*ref_count = 0;
+	*size = 0;
+	if (!cell)
+		return;
+	index = zram_sddc_index_decode(cell);
+	if (index >= sddc->nr_slots || !zram->table) {
+		/* An unresolvable cell is protected from eviction.  It will be
+		 * rejected by source validation and naturally replaced later. */
+		*ref_count = U32_MAX;
+		*size = U32_MAX;
+		return;
+	}
+
+	/* Insertion runs under index_lock, while publication runs under a slot
+	 * lock and then takes index_lock.  Never wait for the slot here: a
+	 * blocking acquisition would invert that order and can deadlock against
+	 * a concurrent publication.  A busy cell is simply protected for this
+	 * insertion attempt and will be reconsidered on a later replacement. */
+	if (!spin_trylock(&zram->table[index].lock)) {
+		*ref_count = U32_MAX;
+		*size = U32_MAX;
+		return;
+	}
+	entry = zram_sddc_state_load_raw(sddc, index);
+	if (entry && entry != XA_ZERO_ENTRY && !xa_is_err(entry)) {
+		state = entry;
+		if (state->kind == ZRAM_SDDC_REF)
+			ref = zram_sddc_ref_pin(sddc, &state->ref);
+	}
+	if (ref) {
+		*ref_count = zram_sddc_ref_count_without_pin(ref);
+		*size = ref->size;
+	} else if (!entry) {
+		*size = zram_sddc_obj_size(zram, index);
+	}
+	spin_unlock(&zram->table[index].lock);
+	zram_sddc_ref_put(ref);
+}
+
+/* Huawei's table keeps highly shared references resident even when a new
+ * object has the same sample score.  Ordinary objects (ref_count == 0) and
+ * one-use references are allowed to rotate on a tie so the table does not
+ * become permanently pinned by its first occupants. */
+static bool zram_sddc_index_candidate_worse(u32 incumbent_ref,
+		u32 incumbent_size, u32 candidate_ref, u32 candidate_size)
+{
+	if (candidate_ref != incumbent_ref)
+		return candidate_ref < incumbent_ref;
+	if (candidate_size != incumbent_size)
+		return candidate_size < incumbent_size;
+	return incumbent_ref <= 2;
+}
+
+static void zram_sddc_index_insert(struct zram_sddc *sddc,
+		struct zram_sddc_bucket *index, u32 hash, u32 slot_index)
+{
+	struct zram_sddc_bucket *bucket;
+	u32 replacement = U32_MAX;
+	u32 replacement_ref = 0;
+	u32 replacement_size = 0;
+	u32 slot;
+	unsigned int i;
+
+	bucket = &index[hash & (ZRAM_SDDC_HASH_BUCKETS - 1)];
+	slot = zram_sddc_index_cell(slot_index);
+	for (i = 0; i < ZRAM_SDDC_BUCKET_WAYS; i++) {
+		u32 ref_count;
+		u32 size;
+
+		if (bucket->cells[i] == slot)
+			return;
+		if (!bucket->cells[i]) {
+			replacement = i;
+			replacement_ref = 0;
+			replacement_size = 0;
+			break;
+		}
+		zram_sddc_index_quality(sddc, bucket->cells[i], &ref_count,
+				&size);
+		if (replacement == U32_MAX ||
+			zram_sddc_index_candidate_worse(replacement_ref,
+				replacement_size, ref_count, size)) {
+			replacement = i;
+			replacement_ref = ref_count;
+			replacement_size = size;
+		}
+	}
+	/* A busy or otherwise unresolvable cell is protected.  If every way is
+	 * protected, defer this insertion rather than evicting one blindly. */
+	if (replacement == U32_MAX || replacement_ref == U32_MAX)
+		return;
+	bucket->cells[replacement] = slot;
+	bucket->next = (bucket->next + 1) % ZRAM_SDDC_BUCKET_WAYS;
+}
+
+static unsigned int zram_sddc_index_candidates(
+		struct zram_sddc_bucket *index, u32 hash, u8 sample_kind,
+		struct zram_sddc_candidate *candidates, unsigned int count,
+		unsigned int max)
+{
+	struct zram_sddc_bucket *bucket;
+	unsigned int i;
+	unsigned int j;
+
+	bucket = &index[hash & (ZRAM_SDDC_HASH_BUCKETS - 1)];
+	for (i = 0; i < ZRAM_SDDC_BUCKET_WAYS && count < max; i++) {
+		u32 cell = bucket->cells[i];
+		bool duplicate = false;
+
+		if (!cell)
+			continue;
+		for (j = 0; j < count; j++) {
+			if (candidates[j].index == zram_sddc_index_decode(cell)) {
+				candidates[j].sample_kind |= sample_kind;
+				duplicate = true;
+				break;
+			}
+		}
+		if (!duplicate) {
+			candidates[count].index = zram_sddc_index_decode(cell);
+			candidates[count].sample_kind = sample_kind;
+			count++;
+		}
+	}
+
+	return count;
+}
+
+static u32 zram_sddc_head_match_bytes(const u8 *target, u32 target_size,
+		const u8 *source, u32 source_size)
+{
+	u32 common;
+	u32 score = ZRAM_SDDC_SAMPLE_SIZE;
+	u32 offset;
+
+	if (memcmp(target, source, ZRAM_SDDC_SAMPLE_SIZE))
+		return 0;
+	common = min(target_size, source_size);
+	for (offset = ZRAM_SDDC_SAMPLE_SIZE;
+	     offset + sizeof(u64) <= common; offset += sizeof(u64)) {
+		if (!memcmp(target + offset, source + offset, sizeof(u64)))
+			score += sizeof(u64);
+	}
+	return score;
+}
+
+static u32 zram_sddc_tail_match_bytes(const u8 *target, u32 target_size,
+		const u8 *source, u32 source_size)
+{
+	u32 target_offset = target_size - ZRAM_SDDC_SAMPLE_SIZE;
+	u32 source_offset = source_size - ZRAM_SDDC_SAMPLE_SIZE;
+	u32 score = ZRAM_SDDC_SAMPLE_SIZE;
+
+	if (memcmp(target + target_offset, source + source_offset,
+		   ZRAM_SDDC_SAMPLE_SIZE))
+		return 0;
+	while (target_offset >= sizeof(u64) && source_offset >= sizeof(u64)) {
+		target_offset -= sizeof(u64);
+		source_offset -= sizeof(u64);
+		if (!memcmp(target + target_offset, source + source_offset,
+			    sizeof(u64)))
+			score += sizeof(u64);
+	}
+	return score;
+}
+
+static u32 zram_sddc_match_bytes(const void *target, u32 target_size,
+		const void *source, u32 source_size, u8 sample_kind)
+{
+	u32 score = 0;
+
+	if (target_size < ZRAM_SDDC_SAMPLE_SIZE ||
+	    source_size < ZRAM_SDDC_SAMPLE_SIZE)
+		return 0;
+	if (sample_kind & ZRAM_SDDC_SAMPLE_HEAD)
+		score = zram_sddc_head_match_bytes(target, target_size, source,
+				source_size);
+	if (sample_kind & ZRAM_SDDC_SAMPLE_TAIL)
+		score = max(score, zram_sddc_tail_match_bytes(target,
+				target_size, source, source_size));
+	return score;
+}
+
+static bool zram_sddc_sample_eligible(u32 size)
+{
+	return size > ZRAM_SDDC_INDEX_MIN_SIZE && size <= PAGE_SIZE;
+}
+
+static void
+zram_sddc_rank_data(const struct zram_sddc_job_key *target,
+		       const void *target_data,
+		       const struct zram_sddc_candidate *candidate,
+		       const void *source_data, u32 source_size, u32 ref_count,
+		       struct zram_sddc_ranked_candidate *ranked)
+{
+	u32 match_bytes = 0;
+
+	if ((candidate->sample_kind & ZRAM_SDDC_SAMPLE_HEAD) &&
+	    source_size == target->size &&
+	    !memcmp(source_data, target_data, target->size))
+		match_bytes = target->size;
+	else if ((source_size == PAGE_SIZE) == (target->size == PAGE_SIZE))
+		match_bytes = zram_sddc_match_bytes(target_data,
+						       target->size,
+						       source_data, source_size,
+						       candidate->sample_kind);
+
+	ranked->candidate = *candidate;
+	ranked->match_bytes = match_bytes;
+	ranked->ref_count = ref_count;
+	ranked->source_size = source_size;
+}
+
+static bool
+zram_sddc_rank_candidate(struct zram_sddc *sddc,
+			    const struct zram_sddc_job_key *target,
+			    const void *target_data,
+			    const struct zram_sddc_candidate *candidate,
+			    struct zram_sddc_ranked_candidate *ranked)
+{
+	struct zram_sddc_slot_state *state;
+	struct zram_sddc_ref *ref;
+	struct zram *zram = sddc->zram;
+	unsigned long handle;
+	void *state_entry;
+	u32 source_size;
+	u32 source_prio;
+	void *source_data;
+
+	if (candidate->index == target->index ||
+	    candidate->index >= sddc->nr_slots)
+		return false;
+
+	zram_sddc_slot_lock(zram, candidate->index);
+	state_entry = zram_sddc_state_load_raw(sddc, candidate->index);
+	if (state_entry == XA_ZERO_ENTRY || xa_is_err(state_entry) ||
+	    zram_sddc_test_flag(zram, candidate->index, ZRAM_SAME) ||
+	    zram_sddc_test_flag(zram, candidate->index, ZRAM_WB))
+		goto unlock;
+
+	state = state_entry;
+	if (state && state->kind == ZRAM_SDDC_REF) {
+		ref = zram_sddc_ref_pin(sddc, &state->ref);
+		zram_sddc_slot_unlock(zram, candidate->index);
+		if (!ref)
+			return false;
+		if (!ref->handle || ref->size < ZRAM_SDDC_SAMPLE_SIZE ||
+		    ref->size > PAGE_SIZE || ref->prio >= ZRAM_MAX_COMPS ||
+		    ref->prio != target->prio) {
+			zram_sddc_ref_put(ref);
+			return false;
+		}
+
+		source_data =
+			zs_map_object(zram->mem_pool, ref->handle, ZS_MM_RO);
+		zram_sddc_rank_data(target, target_data, candidate,
+				       source_data, ref->size,
+				       zram_sddc_ref_count_without_pin(ref),
+				       ranked);
+		zs_unmap_object(zram->mem_pool, ref->handle);
+		zram_sddc_ref_put(ref);
+		return true;
+	}
+	if (state)
+		goto unlock;
+
+	handle = zram->table[candidate->index].handle;
+	source_size = zram_sddc_obj_size(zram, candidate->index);
+	source_prio = zram_sddc_priority(zram, candidate->index);
+	if (!handle || source_size < ZRAM_SDDC_SAMPLE_SIZE ||
+	    source_size > PAGE_SIZE || source_prio != target->prio)
+		goto unlock;
+
+	source_data = zs_map_object(zram->mem_pool, handle, ZS_MM_RO);
+	zram_sddc_rank_data(target, target_data, candidate, source_data,
+			       source_size, 0, ranked);
+	zs_unmap_object(zram->mem_pool, handle);
+	zram_sddc_slot_unlock(zram, candidate->index);
+	return true;
+
+unlock:
+	zram_sddc_slot_unlock(zram, candidate->index);
+	return false;
+}
+
+static int zram_sddc_ranked_candidate_cmp(const void *left,
+		const void *right)
+{
+	const struct zram_sddc_ranked_candidate *a = left;
+	const struct zram_sddc_ranked_candidate *b = right;
+
+	if (a->match_bytes != b->match_bytes)
+		return a->match_bytes < b->match_bytes ? 1 : -1;
+	if (a->ref_count != b->ref_count)
+		return a->ref_count < b->ref_count ? 1 : -1;
+	if (a->source_size != b->source_size)
+		return a->source_size < b->source_size ? 1 : -1;
+	return 0;
+}
+
+static unsigned int zram_sddc_rank_candidates(struct zram_sddc *sddc,
+		const struct zram_sddc_job_key *target, const void *target_data,
+		struct zram_sddc_candidate *candidates, unsigned int count,
+		struct zram_sddc_ranked_candidate *ranked)
+{
+	unsigned int i;
+	unsigned int ranked_count = 0;
+
+	for (i = 0; i < count; i++) {
+		if (zram_sddc_rank_candidate(sddc, target, target_data,
+				&candidates[i], &ranked[ranked_count]))
+			ranked_count++;
+	}
+	sort(ranked, ranked_count, sizeof(*ranked),
+		zram_sddc_ranked_candidate_cmp, NULL);
+	return ranked_count;
+}
+
+static bool zram_sddc_delta_target_eligible(u32 size)
+{
+	return size > ZRAM_SDDC_DELTA_MIN_SIZE &&
+		size > sizeof(struct zram_sddc_delta_header) +
+		ZRAM_SDDC_DELTA_GAIN_MIN;
+}
+
+static bool zram_sddc_source_snapshot(struct zram_sddc *sddc,
+		const struct zram_sddc_candidate *candidate,
+		const struct zram_sddc_job_key *target, void *payload,
+		struct zram_sddc_source *source)
+{
+	struct zram_sddc_slot_state *state;
+	struct zram *zram = sddc->zram;
+	void *state_entry;
+	void *src;
+
+	memset(source, 0, sizeof(*source));
+	if (candidate->index == target->index ||
+	    candidate->index >= sddc->nr_slots)
+		return false;
+
+	zram_sddc_slot_lock(zram, candidate->index);
+	state_entry = zram_sddc_state_load_raw(sddc, candidate->index);
+	if (state_entry == XA_ZERO_ENTRY || xa_is_err(state_entry))
+		goto unlock;
+	state = state_entry;
+	if (zram_sddc_test_flag(zram, candidate->index, ZRAM_SAME) ||
+	    zram_sddc_test_flag(zram, candidate->index, ZRAM_WB))
+		goto unlock;
+
+	source->key.index = candidate->index;
+	source->key.mutation_seq = sddc->mutation_seq[candidate->index];
+	if (state && state->kind == ZRAM_SDDC_REF) {
+		source->cookie = state->ref;
+		source->ref = zram_sddc_ref_pin(sddc, &state->ref);
+		if (!source->ref)
+			goto unlock;
+		source->key.size = source->ref->size;
+		source->key.prio = source->ref->prio;
+		zram_sddc_slot_unlock(zram, candidate->index);
+		if (!source->ref->handle ||
+		    source->key.size < ZRAM_SDDC_SAMPLE_SIZE ||
+		    source->key.size > PAGE_SIZE ||
+		    source->key.prio >= ZRAM_MAX_COMPS ||
+		    source->key.prio != target->prio) {
+			zram_sddc_ref_put(source->ref);
+			source->ref = NULL;
+			return false;
+		}
+		zram_sddc_copy_ref(source->ref, payload);
+		return true;
+	}
+
+	if (state)
+		goto unlock;
+	source->key.handle = zram->table[candidate->index].handle;
+	source->key.size = zram_sddc_obj_size(zram, candidate->index);
+	source->key.prio = zram_sddc_priority(zram, candidate->index);
+	if (!source->key.handle || source->key.size < ZRAM_SDDC_SAMPLE_SIZE ||
+	    source->key.size > PAGE_SIZE || source->key.prio != target->prio)
+		goto unlock;
+
+	src = zs_map_object(zram->mem_pool, source->key.handle, ZS_MM_RO);
+	memcpy(payload, src, source->key.size);
+	zs_unmap_object(zram->mem_pool, source->key.handle);
+	source->ordinary = true;
+	zram_sddc_slot_unlock(zram, candidate->index);
+	return true;
+
+unlock:
+	zram_sddc_slot_unlock(zram, candidate->index);
+	return false;
+}
+
+static struct zram_sddc_ref *
+zram_sddc_promote_source(struct zram_sddc *sddc,
+		struct zram_sddc_source *source,
+		struct zram_sddc_slot_state **prepared_state)
+{
+	struct zram_sddc_ref *ref;
+	struct zram_sddc_slot_state *state;
+	struct zram *zram = sddc->zram;
+
+	if (source->ref)
+		return source->ref;
+	if (!source->ordinary || !prepared_state || !*prepared_state)
+		return NULL;
+	state = *prepared_state;
+
+	ref = zram_sddc_ref_alloc(sddc);
+	if (IS_ERR(ref))
+		return NULL;
+
+	zram_sddc_slot_lock(zram, source->key.index);
+	if (sddc->mutation_seq[source->key.index] !=
+			source->key.mutation_seq ||
+		zram_sddc_state_load_raw(sddc, source->key.index) !=
+				XA_ZERO_ENTRY ||
+	    zram->table[source->key.index].handle != source->key.handle ||
+	    zram_sddc_obj_size(zram, source->key.index) != source->key.size ||
+	    zram_sddc_priority(zram, source->key.index) != source->key.prio ||
+	    zram_sddc_test_flag(zram, source->key.index, ZRAM_SAME) ||
+	    zram_sddc_test_flag(zram, source->key.index, ZRAM_WB))
+		goto fail_unlock;
+
+	ref->handle = source->key.handle;
+	ref->size = source->key.size;
+	ref->prio = source->key.prio;
+	refcount_set(&ref->refs, 2);
+	state->kind = ZRAM_SDDC_REF;
+	state->ref = ref->cookie;
+	if (!zram_sddc_state_install_locked(sddc, source->key.index,
+			state))
+		goto restore_account;
+	if (!zram_sddc_ref_publish(sddc, ref))
+		goto fail_state;
+
+	zram_sddc_clear_storage_flags(zram, source->key.index);
+	zram->table[source->key.index].handle = 0;
+	zram_sddc_set_obj_size(zram, source->key.index, 0);
+	atomic64_inc(&sddc->stats.refs);
+	atomic64_add(ref->size, &sddc->stats.ref_bytes);
+	zram_sddc_slot_unlock(zram, source->key.index);
+	*prepared_state = NULL;
+	source->ref = ref;
+	source->cookie = ref->cookie;
+	return ref;
+
+fail_state:
+	if (WARN_ON_ONCE(!zram_sddc_xa_erase_if(&sddc->slot_states,
+			source->key.index, state)))
+		goto restore_account;
+	*prepared_state = NULL;
+	kfree(state);
+restore_account:
+fail_unlock:
+	zram_sddc_slot_unlock(zram, source->key.index);
+	zram_sddc_ref_abort(ref);
+	return NULL;
+}
+
+static bool zram_sddc_commit_target(struct zram_sddc *sddc,
+		const struct zram_sddc_job_key *target,
+		struct zram_sddc_ref *ref, enum zram_sddc_kind kind,
+		unsigned long new_handle, u32 new_size,
+		struct zram_sddc_slot_state **prepared_state)
+{
+	struct zram_sddc_slot_state *state;
+	struct zram *zram = sddc->zram;
+	unsigned long old_handle;
+	u32 old_size;
+	u32 saved_size;
+	bool committed = false;
+
+	if (!prepared_state || !*prepared_state)
+		return false;
+	state = *prepared_state;
+
+	zram_sddc_slot_lock(zram, target->index);
+	if (!zram_sddc_job_matches_locked(sddc, target, true))
+		goto unlock;
+
+	old_handle = zram->table[target->index].handle;
+	old_size = zram_sddc_obj_size(zram, target->index);
+	saved_size = old_size > new_size ? old_size - new_size : 0;
+	state->kind = kind;
+	state->ref = ref->cookie;
+	state->accounted_size = new_size;
+	state->saved_size = saved_size;
+	if (!zram_sddc_state_install_locked(sddc, target->index, state))
+		goto restore_account;
+	zram_sddc_clear_storage_flags(zram, target->index);
+	zs_free(zram->mem_pool, old_handle);
+	atomic64_sub(old_size, &zram->stats.compr_data_size);
+	zram->table[target->index].handle = new_handle;
+	zram_sddc_set_obj_size(zram, target->index, new_size);
+	if (new_size)
+		atomic64_add(new_size, &zram->stats.compr_data_size);
+	atomic64_add(saved_size, &sddc->stats.saved_bytes);
+	atomic64_add(saved_size, &sddc->stats.saved_bytes_total);
+	if (kind == ZRAM_SDDC_ALIAS) {
+		atomic64_inc(&sddc->stats.aliases);
+	} else if (kind == ZRAM_SDDC_DELTA) {
+		atomic64_inc(&sddc->stats.deltas);
+		atomic64_add(new_size, &sddc->stats.delta_bytes);
+	}
+	*prepared_state = NULL;
+	committed = true;
+	goto unlock;
+
+restore_account:
+
+unlock:
+	zram_sddc_slot_unlock(zram, target->index);
+	return committed;
+}
+
+static bool zram_sddc_try_alias(struct zram_sddc *sddc,
+		const struct zram_sddc_job_key *target, const void *target_data,
+		const struct zram_sddc_candidate *candidate, void *ref_data)
+{
+	struct zram_sddc_slot_state *source_state = NULL;
+	struct zram_sddc_slot_state *target_state = NULL;
+	struct zram_sddc_source source;
+	struct zram_sddc_ref *ref;
+	bool committed = false;
+
+	if (!zram_sddc_source_snapshot(sddc, candidate, target, ref_data,
+			&source))
+		return false;
+	if (source.key.size != target->size ||
+	    memcmp(ref_data, target_data, target->size))
+		goto out;
+
+	target_state = zram_sddc_state_prepare(sddc, target->index);
+	if (!target_state)
+		goto allocation_failed;
+	if (source.ordinary) {
+		source_state = zram_sddc_state_prepare(sddc,
+				source.key.index);
+		if (!source_state)
+			goto allocation_failed;
+	}
+
+	ref = zram_sddc_promote_source(sddc, &source, &source_state);
+	if (!ref) {
+		atomic64_inc(&sddc->stats.conversion_failures);
+		goto out;
+	}
+	if (zram_sddc_commit_target(sddc, target, ref,
+			ZRAM_SDDC_ALIAS, 0, 0, &target_state)) {
+		source.ref = NULL;
+		committed = true;
+		goto out;
+	}
+
+	zram_sddc_ref_put(ref);
+	source.ref = NULL;
+	atomic64_inc(&sddc->stats.conversion_failures);
+	goto out;
+
+allocation_failed:
+	atomic64_inc(&sddc->stats.conversion_failures);
+out:
+	zram_sddc_ref_put(source.ref);
+	zram_sddc_state_abort(sddc, source.key.index,
+			source.key.mutation_seq, source_state);
+	zram_sddc_state_abort(sddc, target->index, target->mutation_seq,
+			target_state);
+	return committed;
+}
+
+static bool zram_sddc_try_delta(struct zram_sddc *sddc,
+		const struct zram_sddc_job_key *target, const void *target_data,
+		const struct zram_sddc_candidate *candidate,
+		struct zram_sddc_workspace *workspace)
+{
+	struct zram_sddc_delta_header header;
+	struct zram_sddc_slot_state *source_state = NULL;
+	struct zram_sddc_slot_state *target_state = NULL;
+	struct zram_sddc_source source;
+	struct zram_sddc_ref *ref;
+	struct zcomp_strm *zstrm;
+	unsigned long handle;
+	unsigned int delta_len;
+	unsigned int out_limit;
+	u32 wire_size;
+	void *delta = (u8 *)workspace->wire + sizeof(header);
+	void *dst;
+	bool committed = false;
+	int ret;
+
+	/* Keep the async delta path aligned with Huawei's high-yield admission
+	 * heuristic.  Smaller objects may still use the exact-alias path, but the
+	 * 24-byte delta header and codec work are not worthwhile below this floor. */
+	if (!zram_sddc_delta_target_eligible(target->size)) {
+		atomic64_inc(&sddc->stats.delta_small_rejects);
+		return false;
+	}
+	if (!zram_sddc_source_snapshot(sddc, candidate, target,
+			workspace->ref_data, &source))
+		return false;
+	if ((source.key.size == PAGE_SIZE) != (target->size == PAGE_SIZE))
+		goto out;
+
+	target_state = zram_sddc_state_prepare(sddc, target->index);
+	if (!target_state)
+		goto allocation_failed;
+	if (source.ordinary) {
+		source_state = zram_sddc_state_prepare(sddc,
+				source.key.index);
+		if (!source_state)
+			goto allocation_failed;
+	}
+
+	out_limit = target->size - sizeof(header) -
+		ZRAM_SDDC_DELTA_GAIN_MIN;
+	zstrm = zcomp_stream_get(sddc->zram->comps[target->prio]);
+	if (!zstrm)
+		goto out;
+	delta_len = 2 * PAGE_SIZE;
+	ret = zcomp_compress_delta(zstrm, workspace->ref_data, source.key.size,
+			target_data, target->size, &delta_len, out_limit);
+	if (!ret && delta_len && delta_len <= out_limit)
+		memcpy(delta, zstrm->buffer, delta_len);
+	else
+		delta = NULL;
+	zcomp_stream_put(sddc->zram->comps[target->prio]);
+	if (!delta) {
+		atomic64_inc(&sddc->stats.delta_no_gain);
+		goto out;
+	}
+
+	wire_size = sizeof(header) + delta_len;
+	if (zs_lookup_class_index(sddc->zram->mem_pool, wire_size) >=
+	    zs_lookup_class_index(sddc->zram->mem_pool, target->size)) {
+		atomic64_inc(&sddc->stats.delta_no_gain);
+		goto out;
+	}
+	handle = zs_malloc(sddc->zram->mem_pool, wire_size,
+			GFP_NOIO | __GFP_HIGHMEM | __GFP_MOVABLE | __GFP_CMA);
+	if (IS_ERR_VALUE(handle)) {
+		atomic64_inc(&sddc->stats.conversion_failures);
+		goto out;
+	}
+	if (!zram_sddc_memory_limit_ok(sddc->zram)) {
+		atomic64_inc(&sddc->stats.limit_rejects);
+		atomic64_inc(&sddc->stats.conversion_failures);
+		goto free_handle;
+	}
+
+	ref = zram_sddc_promote_source(sddc, &source, &source_state);
+	if (!ref) {
+		atomic64_inc(&sddc->stats.conversion_failures);
+		goto free_handle;
+	}
+	header.magic = cpu_to_le32(ZRAM_SDDC_DELTA_MAGIC);
+	header.version = cpu_to_le16(ZRAM_SDDC_DELTA_VERSION);
+	header.header_size = cpu_to_le16(sizeof(header));
+	header.ref_id = cpu_to_le32(ref->cookie.id);
+	header.ref_generation = cpu_to_le32(ref->cookie.generation);
+	header.ref_size = cpu_to_le32(ref->size);
+	header.target_size = cpu_to_le32(target->size);
+	memcpy(workspace->wire, &header, sizeof(header));
+	dst = zs_map_object(sddc->zram->mem_pool, handle, ZS_MM_WO);
+	memcpy(dst, workspace->wire, wire_size);
+	zs_unmap_object(sddc->zram->mem_pool, handle);
+
+	if (zram_sddc_commit_target(sddc, target, ref,
+			ZRAM_SDDC_DELTA, handle, wire_size, &target_state)) {
+		source.ref = NULL;
+		committed = true;
+		goto out;
+	}
+
+	zram_sddc_ref_put(ref);
+	source.ref = NULL;
+	atomic64_inc(&sddc->stats.conversion_failures);
+free_handle:
+	zs_free(sddc->zram->mem_pool, handle);
+out:
+	zram_sddc_ref_put(source.ref);
+	zram_sddc_state_abort(sddc, source.key.index,
+			source.key.mutation_seq, source_state);
+	zram_sddc_state_abort(sddc, target->index, target->mutation_seq,
+			target_state);
+	return committed;
+
+allocation_failed:
+	atomic64_inc(&sddc->stats.conversion_failures);
+	goto out;
+}
+
+static bool zram_sddc_try_convert(struct zram_sddc *sddc,
+		const struct zram_sddc_job_key *target, const void *target_data,
+		u32 exact_hash, u32 head_hash, u32 tail_hash,
+		struct zram_sddc_workspace *workspace)
+{
+	struct zram_sddc_candidate candidates[ZRAM_SDDC_BUCKET_WAYS * 2];
+	struct zram_sddc_ranked_candidate ranked[ARRAY_SIZE(candidates)];
+	unsigned int count = 0;
+	unsigned int i;
+	bool converted = false;
+
+	spin_lock(&sddc->index_lock);
+	count = zram_sddc_index_candidates(sddc->exact_index, exact_hash,
+			ZRAM_SDDC_SAMPLE_HEAD, candidates, count,
+				ARRAY_SIZE(candidates));
+	spin_unlock(&sddc->index_lock);
+	count = zram_sddc_rank_candidates(sddc, target, target_data,
+			candidates, count, ranked);
+	for (i = 0; i < count; i++) {
+		atomic64_inc(&sddc->stats.alias_attempts);
+		if (zram_sddc_try_alias(sddc, target, target_data,
+				&ranked[i].candidate, workspace->ref_data)) {
+			atomic64_inc(&sddc->stats.alias_hits);
+			converted = true;
+			goto out;
+		}
+	}
+	if (!zram_sddc_delta_target_eligible(target->size)) {
+		atomic64_inc(&sddc->stats.delta_small_rejects);
+		goto out;
+	}
+
+	count = 0;
+	spin_lock(&sddc->index_lock);
+	count = zram_sddc_index_candidates(sddc->sample_index, head_hash,
+			ZRAM_SDDC_SAMPLE_HEAD, candidates, count,
+			ARRAY_SIZE(candidates));
+	count = zram_sddc_index_candidates(sddc->sample_index, tail_hash,
+				ZRAM_SDDC_SAMPLE_TAIL, candidates, count,
+				ARRAY_SIZE(candidates));
+	spin_unlock(&sddc->index_lock);
+	count = zram_sddc_rank_candidates(sddc, target, target_data,
+			candidates, count, ranked);
+	for (i = 0; i < count; i++) {
+		if (ranked[i].match_bytes < ZRAM_SDDC_SIMILARITY_MIN)
+			break;
+		atomic64_inc(&sddc->stats.delta_matches);
+		zram_sddc_atomic64_update_max(&sddc->stats.delta_match_bytes_max,
+				ranked[i].match_bytes);
+		atomic64_inc(&sddc->stats.delta_attempts);
+		if (zram_sddc_try_delta(sddc, target, target_data,
+				&ranked[i].candidate, workspace)) {
+			atomic64_inc(&sddc->stats.delta_hits);
+			converted = true;
+			goto out;
+		}
+	}
+
+out:
+	return converted;
+}
+
+/* state_lock serializes the bitmap and the idle-to-running transition. */
+static bool zram_sddc_observe_mark_locked(struct zram_sddc *sddc,
+		u32 index)
+{
+	if (WARN_ON_ONCE(index >= sddc->nr_slots))
+		return false;
+	if (test_and_set_bit(index, sddc->observe_pending)) {
+		atomic64_inc(&sddc->stats.coalesced);
+		return false;
+	}
+
+	sddc->pending++;
+	zram_sddc_atomic64_update_max(&sddc->stats.pending_max,
+			sddc->pending);
+	return true;
+}
+
+static bool zram_sddc_observe_activate_locked(struct zram_sddc *sddc)
+{
+	if (sddc->observe_worker_active)
+		return false;
+
+	sddc->observe_worker_active = true;
+	return true;
+}
+
+static void zram_sddc_observe_deactivate_locked(struct zram_sddc *sddc, unsigned int work_id)
+{
+	sddc->observe_work_cursor = work_id ^ 1;
+	sddc->observe_worker_active = false;
+}
+
+static unsigned int zram_sddc_observe_discard_locked(
+		struct zram_sddc *sddc)
+{
+	unsigned int discarded = sddc->pending;
+
+	if (discarded)
+		atomic64_add(discarded, &sddc->stats.shutdown_discarded);
+	bitmap_zero(sddc->observe_pending, (unsigned int)sddc->nr_slots);
+	sddc->pending = 0;
+	return discarded;
+}
+
+static bool zram_sddc_observe_take_locked(struct zram_sddc *sddc,
+		u32 *index)
+{
+	unsigned long next;
+
+	if (!sddc->pending)
+		return false;
+
+	next = find_next_bit(sddc->observe_pending, sddc->nr_slots,
+			sddc->observe_cursor);
+	if (next >= sddc->nr_slots && sddc->observe_cursor)
+		next = find_first_bit(sddc->observe_pending, sddc->nr_slots);
+	if (WARN_ON_ONCE(next >= sddc->nr_slots)) {
+		/* Keep the bitmap/count invariant recoverable even if corruption or
+		 * an unexpected find-bit result leaves no consumable slot. */
+		bitmap_zero(sddc->observe_pending, (unsigned int)sddc->nr_slots);
+		sddc->pending = 0;
+		return false;
+	}
+
+	clear_bit(next, sddc->observe_pending);
+	sddc->pending--;
+	sddc->observe_cursor = next + 1;
+	if (sddc->observe_cursor >= sddc->nr_slots)
+		sddc->observe_cursor = 0;
+	*index = next;
+	return true;
+}
+
+static void zram_sddc_observe_index(struct zram_sddc *sddc,
+		u32 index, struct zram_sddc_workspace *workspace)
+{
+	struct zram_sddc_job_key key;
+	struct zram *zram = sddc->zram;
+	u32 exact_hash;
+	u32 head_hash;
+	u32 tail_hash;
+	void *payload = workspace->ordinary;
+	void *src;
+	bool converted;
+	bool still_matches;
+
+	down_read(&zram->init_lock);
+	if (zram->sddc != sddc || !zram->table ||
+	    index >= (zram->disksize >> PAGE_SHIFT))
+		goto out_unlock;
+
+	zram_sddc_slot_lock(zram, index);
+	zram_sddc_job_key_locked(zram, index, &key);
+	if (!key.handle) {
+		zram_sddc_slot_unlock(zram, index);
+		atomic64_inc(&sddc->stats.ineligible);
+		goto out_unlock;
+	}
+
+	src = zs_map_object(zram->mem_pool, key.handle, ZS_MM_RO);
+	memcpy(payload, src, key.size);
+	zs_unmap_object(zram->mem_pool, key.handle);
+	zram_sddc_slot_unlock(zram, index);
+
+	exact_hash = jhash(payload, key.size,
+			ZRAM_SDDC_HASH_SEED ^ key.size);
+	head_hash = jhash(payload, ZRAM_SDDC_SAMPLE_SIZE,
+			ZRAM_SDDC_HASH_SEED);
+	tail_hash = jhash(payload + key.size - ZRAM_SDDC_SAMPLE_SIZE,
+			ZRAM_SDDC_SAMPLE_SIZE, ZRAM_SDDC_HASH_SEED);
+	converted = zram_sddc_try_convert(sddc, &key, payload, exact_hash,
+			head_hash, tail_hash, workspace);
+
+	if (!converted) {
+		/* A conversion can race a rewrite after the initial snapshot.  Do not
+		 * publish an empty or managed slot.  Index cells intentionally carry
+		 * only a slot number; later source validation resolves the latest
+		 * representation and makes stale cells harmless. */
+		zram_sddc_slot_lock(zram, index);
+		still_matches = zram_sddc_job_matches_locked(sddc, &key, false);
+		if (!still_matches) {
+			zram_sddc_slot_unlock(zram, index);
+			atomic64_inc(&sddc->stats.stale);
+			goto observed;
+		}
+		spin_lock(&sddc->index_lock);
+		zram_sddc_index_insert(sddc, sddc->exact_index, exact_hash,
+				key.index);
+		if (zram_sddc_sample_eligible(key.size)) {
+			zram_sddc_index_insert(sddc, sddc->sample_index, head_hash,
+					key.index);
+			zram_sddc_index_insert(sddc, sddc->sample_index, tail_hash,
+					key.index);
+		}
+		spin_unlock(&sddc->index_lock);
+		/* Keep validation and publication in one slot critical section.  A
+		 * rewrite cannot invalidate the identity between the final check and
+		 * insertion of its candidate cell. */
+		zram_sddc_slot_unlock(zram, index);
+		atomic64_inc(&sddc->stats.indexed);
+	}
+
+observed:
+	atomic64_inc(&sddc->stats.observed);
+
+out_unlock:
+	up_read(&zram->init_lock);
+}
+
+static bool zram_sddc_observe_handoff(
+		struct zram_sddc_observe_work *observe)
+{
+	struct zram_sddc *sddc = observe->sddc;
+	bool pending;
+
+	spin_lock(&sddc->state_lock);
+	pending = !READ_ONCE(sddc->stopping) && sddc->pending;
+	spin_unlock(&sddc->state_lock);
+	if (!pending)
+		return false;
+
+	/* Transfer this callback's lifetime token to the other embedded item;
+	 * the current callback remains running until its caller returns. */
+	return queue_work(sddc->workqueue,
+			&sddc->observe_work[observe->id ^ 1].work);
+}
+
+static void zram_sddc_observe_workfn(struct work_struct *work)
+{
+	struct zram_sddc_observe_work *observe = container_of(work,
+			struct zram_sddc_observe_work, work);
+	struct zram_sddc *sddc = observe->sddc;
+	struct zram_sddc_workspace *workspace;
+	u32 index;
+	unsigned int budget = ZRAM_SDDC_OBSERVE_BUDGET;
+
+	atomic64_inc(&sddc->stats.worker_runs);
+	workspace = sddc->observe_workspace;
+	for (;;) {
+		spin_lock(&sddc->state_lock);
+		if (!zram_sddc_observe_take_locked(sddc, &index)) {
+			/* Commit to exiting while admission is serialized.  A later
+			 * producer will queue the alternate item instead of relying on
+			 * this callback while it is returning.
+			 */
+			zram_sddc_observe_deactivate_locked(sddc, observe->id);
+			spin_unlock(&sddc->state_lock);
+			break;
+		}
+		spin_unlock(&sddc->state_lock);
+
+		zram_sddc_observe_index(sddc, index, workspace);
+		cond_resched();
+		if (!--budget) {
+			bool stopping;
+
+			/* Bound each callback so a continuously rewritten device cannot
+			 * starve freezer/reset progress.  A successful handoff transfers
+			 * this callback's lifetime token and zram reference. */
+			if (zram_sddc_observe_handoff(observe)) {
+				return;
+			}
+			spin_lock(&sddc->state_lock);
+			stopping = READ_ONCE(sddc->stopping);
+			if (stopping) {
+				zram_sddc_observe_discard_locked(sddc);
+				zram_sddc_observe_deactivate_locked(sddc, observe->id);
+			}
+			spin_unlock(&sddc->state_lock);
+			if (stopping)
+				break;
+			/* A failed handoff means the alternate item is already busy.
+			 * Retain this drain's lifetime ownership and continue.
+			 */
+			budget = ZRAM_SDDC_OBSERVE_BUDGET;
+		}
+	}
+
+	/* reset/remove closes admission and drains this manager before freeing zram. */
+	zram_sddc_manager_put(sddc);
+}
+
+int zram_sddc_create(struct zram *zram, unsigned long nr_pages)
+{
+	struct zram_sddc *sddc;
+	unsigned int i;
+
+	if (!zram)
+		return -EINVAL;
+	lockdep_assert_held(&zram->sddc_lifecycle_lock);
+	lockdep_assert_held_write(&zram->init_lock);
+	if (zram->sddc)
+		return -EINVAL;
+	if (PAGE_SHIFT != 12 || !nr_pages ||
+	    nr_pages > ZRAM_SDDC_MAX_SLOTS ||
+	    !zram->comps[ZRAM_PRIMARY_COMP] ||
+	    !zcomp_supports_delta(zram->comps[ZRAM_PRIMARY_COMP]))
+		return 0;
+
+	sddc = kzalloc(sizeof(*sddc), GFP_KERNEL);
+	if (!sddc) {
+		pr_warn("%s: SDDC manager allocation failed; using ordinary compression\n",
+			zram->disk->disk_name);
+		return 0;
+	}
+	ida_init(&sddc->ref_ids);
+	xa_init(&sddc->refs);
+	xa_init(&sddc->slot_states);
+	sddc->zram = zram;
+	sddc->nr_slots = nr_pages;
+	spin_lock_init(&sddc->state_lock);
+	spin_lock_init(&sddc->index_lock);
+	spin_lock_init(&sddc->active_lock);
+	atomic_set(&sddc->active_ops, 0);
+	init_waitqueue_head(&sddc->active_wait);
+	for (i = 0; i < ZRAM_SDDC_OBSERVE_WORKS; i++) {
+		sddc->observe_work[i].sddc = sddc;
+		sddc->observe_work[i].id = i;
+		INIT_WORK(&sddc->observe_work[i].work,
+			zram_sddc_observe_workfn);
+	}
+
+	sddc->mutation_seq = vzalloc(array_size(nr_pages,
+						sizeof(*sddc->mutation_seq)));
+	sddc->observe_pending = bitmap_zalloc((unsigned int)nr_pages,
+						 GFP_KERNEL | __GFP_NOWARN);
+	sddc->exact_index = vzalloc(array_size(ZRAM_SDDC_HASH_BUCKETS,
+					       sizeof(*sddc->exact_index)));
+	sddc->sample_index = vzalloc(array_size(ZRAM_SDDC_HASH_BUCKETS,
+							sizeof(*sddc->sample_index)));
+	if (!sddc->mutation_seq || !sddc->observe_pending ||
+	    !sddc->exact_index || !sddc->sample_index)
+		goto fail;
+
+	sddc->observe_workspace = zram_sddc_workspace_alloc(GFP_KERNEL);
+	if (!sddc->observe_workspace)
+		goto fail;
+
+	/* Huawei runs SDDC recompression from a reclaim-capable worker.  Keep the
+	 * ordered/budgeted hand-off, but do not let freezer state postpone the
+	 * index while memory pressure is actively building.  reset still closes
+	 * admission and flushes this queue before taking init_lock for write. */
+	sddc->workqueue = alloc_ordered_workqueue("%s-sddc",
+				WQ_MEM_RECLAIM | WQ_HIGHPRI, zram->disk->disk_name);
+	if (!sddc->workqueue)
+		goto fail;
+	sddc->free_workqueue = alloc_workqueue("%s-sddc-free",
+			WQ_MEM_RECLAIM | WQ_UNBOUND | WQ_HIGHPRI, 0,
+			zram->disk->disk_name);
+	if (!sddc->free_workqueue)
+		goto fail;
+
+	spin_lock(&zram->sddc_lock);
+	WARN_ON_ONCE(zram->sddc);
+	WRITE_ONCE(zram->sddc, sddc);
+	spin_unlock(&zram->sddc_lock);
+	return 0;
+
+fail:
+	pr_warn("%s: SDDC metadata allocation failed; using ordinary compression\n",
+		zram->disk->disk_name);
+	if (sddc->free_workqueue)
+		destroy_workqueue(sddc->free_workqueue);
+	if (sddc->workqueue)
+		destroy_workqueue(sddc->workqueue);
+	zram_sddc_workspace_free(sddc->observe_workspace);
+	bitmap_free(sddc->observe_pending);
+	vfree(sddc->sample_index);
+	vfree(sddc->exact_index);
+	vfree(sddc->mutation_seq);
+	xa_destroy(&sddc->slot_states);
+	xa_destroy(&sddc->refs);
+	ida_destroy(&sddc->ref_ids);
+	kfree(sddc);
+	/* SDDC is opportunistic; retain ordinary LZ4KD zram on allocation loss. */
+	return 0;
+}
+
+void zram_sddc_stop(struct zram *zram)
+{
+	struct zram_sddc *sddc;
+
+	if (!zram)
+		return;
+	lockdep_assert_held(&zram->sddc_lifecycle_lock);
+	spin_lock(&zram->sddc_lock);
+	sddc = READ_ONCE(zram->sddc);
+	if (sddc)
+		WRITE_ONCE(sddc->stopping, true);
+	spin_unlock(&zram->sddc_lock);
+	if (!sddc)
+		return;
+
+	spin_lock(&sddc->state_lock);
+	zram_sddc_observe_discard_locked(sddc);
+	spin_unlock(&sddc->state_lock);
+	flush_workqueue(sddc->workqueue);
+	zram_sddc_manager_wait_idle(sddc);
+	WARN_ON_ONCE(READ_ONCE(sddc->pending));
+	flush_workqueue(sddc->free_workqueue);
+}
+
+/* The normal zram teardown path frees every slot before reaching destroy().
+ * Keep the invariant failure recoverable nevertheless: xarray nodes do not
+ * own the heap values stored in them, and ref values may still own zsmalloc
+ * handles.  At this point active operations and free work are quiescent. */
+static void zram_sddc_destroy_metadata(struct zram_sddc *sddc)
+{
+	struct zram_sddc_slot_state *state;
+	struct zram_sddc_ref *ref;
+	unsigned long index;
+
+	xa_for_each(&sddc->slot_states, index, state) {
+		if (!state || state == XA_ZERO_ENTRY || xa_is_err(state))
+			continue;
+		if (xa_erase(&sddc->slot_states, index) == state)
+			kfree(state);
+	}
+
+	/* A ref is removed from the xarray before its deferred free work is
+	 * queued, so anything left here can be released synchronously. */
+	xa_for_each(&sddc->refs, index, ref) {
+		if (!ref || ref == XA_ZERO_ENTRY || xa_is_err(ref))
+			continue;
+		if (xa_erase(&sddc->refs, index) == ref)
+			zram_sddc_ref_release(ref);
+	}
+}
+
+void zram_sddc_destroy(struct zram *zram)
+{
+	struct zram_sddc *sddc;
+
+	if (!zram)
+		return;
+	lockdep_assert_held(&zram->sddc_lifecycle_lock);
+	lockdep_assert_held_write(&zram->init_lock);
+	sddc = zram->sddc;
+	if (!sddc)
+		return;
+
+	WARN_ON_ONCE(!READ_ONCE(sddc->stopping));
+	WARN_ON_ONCE(atomic_read(&sddc->active_ops));
+	WARN_ON_ONCE(READ_ONCE(sddc->pending));
+	spin_lock(&zram->sddc_lock);
+	WARN_ON_ONCE(zram->sddc != sddc);
+	WRITE_ONCE(zram->sddc, NULL);
+	spin_unlock(&zram->sddc_lock);
+	flush_workqueue(sddc->free_workqueue);
+	WARN_ON_ONCE(!xa_empty(&sddc->slot_states));
+	WARN_ON_ONCE(!xa_empty(&sddc->refs));
+	destroy_workqueue(sddc->workqueue);
+	destroy_workqueue(sddc->free_workqueue);
+	zram_sddc_destroy_metadata(sddc);
+	bitmap_free(sddc->observe_pending);
+	zram_sddc_workspace_free(sddc->observe_workspace);
+	vfree(sddc->sample_index);
+	vfree(sddc->exact_index);
+	vfree(sddc->mutation_seq);
+	xa_destroy(&sddc->slot_states);
+	xa_destroy(&sddc->refs);
+	ida_destroy(&sddc->ref_ids);
+	kfree(sddc);
+}
+
+enum zram_sddc_kind zram_sddc_slot_free_locked(struct zram *zram,
+		u32 index)
+{
+	struct zram_sddc *sddc = zram->sddc;
+	struct zram_sddc_slot_state *state;
+	struct zram_sddc_cookie cookie;
+	enum zram_sddc_kind kind;
+	u32 accounted_size;
+	u32 saved_size;
+
+	if (!sddc || index >= sddc->nr_slots)
+		return ZRAM_SDDC_NONE;
+
+	state = zram_sddc_state_load_raw(sddc, index);
+	if (xa_is_err(state)) {
+		WARN_ON_ONCE(1);
+		state = NULL;
+	} else if (xa_is_zero(state)) {
+		state = NULL;
+	} else if (state) {
+		state = zram_sddc_xa_erase_if(&sddc->slot_states, index,
+				state);
+		if (!state) {
+			WARN_ON_ONCE(1);
+		}
+	}
+	if (state) {
+		kind = state->kind;
+		cookie = state->ref;
+		accounted_size = state->accounted_size;
+		saved_size = state->saved_size;
+	} else {
+		kind = ZRAM_SDDC_NONE;
+		memset(&cookie, 0, sizeof(cookie));
+		accounted_size = 0;
+		saved_size = 0;
+	}
+	zram_sddc_mutation_advance_locked(sddc, index);
+	if (kind == ZRAM_SDDC_ALIAS)
+		atomic64_dec(&sddc->stats.aliases);
+	else if (kind == ZRAM_SDDC_DELTA) {
+		atomic64_dec(&sddc->stats.deltas);
+		atomic64_sub(accounted_size, &sddc->stats.delta_bytes);
+	}
+	atomic64_sub(saved_size, &sddc->stats.saved_bytes);
+	if (kind != ZRAM_SDDC_NONE)
+		zram_sddc_ref_drop_cookie(sddc, &cookie);
+	kfree(state);
+
+	return kind;
+}
+
+void zram_sddc_slot_stored_locked(struct zram *zram, u32 index)
+{
+	struct zram_sddc *sddc = zram->sddc;
+	void *entry;
+
+	if (sddc && index < sddc->nr_slots) {
+		entry = zram_sddc_state_load_raw(sddc, index);
+		WARN_ON_ONCE(entry && entry != XA_ZERO_ENTRY);
+		zram_sddc_mutation_advance_locked(sddc, index);
+	}
+}
+
+void zram_sddc_job_key_locked(struct zram *zram, u32 index,
+		struct zram_sddc_job_key *key)
+{
+	struct zram_sddc *sddc = zram->sddc;
+	void *state_entry;
+	unsigned long handle;
+	u32 size;
+	u32 prio;
+
+	memset(key, 0, sizeof(*key));
+	if (!sddc || index >= sddc->nr_slots)
+		return;
+	/* Treat an in-flight XA_ZERO_ENTRY reservation as ineligible too.  The
+	 * owner will requeue the slot after aborting, so producers must not build
+	 * keys that can only fail reservation admission. */
+	state_entry = zram_sddc_state_load_raw(sddc, index);
+	if (state_entry ||
+	    zram_sddc_test_flag(zram, index, ZRAM_SAME) ||
+	    zram_sddc_test_flag(zram, index, ZRAM_WB))
+		return;
+
+	handle = zram->table[index].handle;
+	size = zram_sddc_obj_size(zram, index);
+	prio = zram_sddc_priority(zram, index);
+	/* Small streams do not enter the asynchronous SDDC index.  This keeps
+	 * index pressure and observation CPU focused on objects with useful
+	 * sharing/delta potential, matching the original admission heuristic. */
+	if (!handle || size <= ZRAM_SDDC_INDEX_MIN_SIZE || size > PAGE_SIZE ||
+	    prio != ZRAM_PRIMARY_COMP || !zram->comps[prio] ||
+	    !zcomp_supports_delta(zram->comps[prio]))
+		return;
+
+	key->index = index;
+	key->mutation_seq = sddc->mutation_seq[index];
+	key->handle = handle;
+	key->size = size;
+	key->prio = prio;
+}
+
+void zram_sddc_requeue_observation(struct zram *zram, u32 index)
+{
+	struct zram_sddc_job_key key;
+	struct zram_sddc *sddc;
+
+	if (!zram)
+		return;
+	sddc = zram_sddc_manager_get(zram);
+	if (!sddc)
+		return;
+	if (index >= sddc->nr_slots) {
+		zram_sddc_manager_put(sddc);
+		return;
+	}
+	zram_sddc_slot_lock(zram, index);
+	zram_sddc_job_key_locked(zram, index, &key);
+	zram_sddc_slot_unlock(zram, index);
+	zram_sddc_queue_observation(zram, &key);
+	zram_sddc_manager_put(sddc);
+}
+
+bool zram_sddc_slot_allocated_locked(struct zram *zram, u32 index)
+{
+	struct zram_sddc *sddc = zram->sddc;
+
+	return sddc && index < sddc->nr_slots &&
+		zram_sddc_state_load_locked(sddc, index);
+}
+
+bool zram_sddc_slot_managed_locked(struct zram *zram, u32 index)
+{
+	return zram_sddc_slot_allocated_locked(zram, index);
+}
+
+bool zram_sddc_accounted_size_locked(struct zram *zram, u32 index,
+		size_t *size)
+{
+	struct zram_sddc *sddc = zram->sddc;
+	struct zram_sddc_slot_state *state;
+
+	if (!sddc || index >= sddc->nr_slots)
+		return false;
+	state = zram_sddc_state_load_locked(sddc, index);
+	if (!state)
+		return false;
+	*size = state->accounted_size;
+	return true;
+}
+
+void zram_sddc_snapshot_locked(struct zram *zram, u32 index,
+		struct zram_sddc_snapshot *snapshot)
+{
+	struct zram_sddc *sddc = zram->sddc;
+	struct zram_sddc_slot_state *state;
+
+	memset(snapshot, 0, sizeof(*snapshot));
+	if (!sddc || index >= sddc->nr_slots)
+		return;
+	snapshot->mutation_seq = sddc->mutation_seq[index];
+	state = zram_sddc_state_load_locked(sddc, index);
+	if (!state)
+		return;
+	snapshot->ref = state->ref;
+	snapshot->kind = state->kind;
+}
+
+bool zram_sddc_snapshot_matches_locked(struct zram *zram, u32 index,
+		const struct zram_sddc_snapshot *snapshot)
+{
+	struct zram_sddc_snapshot current_snapshot;
+
+	zram_sddc_snapshot_locked(zram, index, &current_snapshot);
+	return current_snapshot.mutation_seq == snapshot->mutation_seq &&
+		current_snapshot.kind == snapshot->kind &&
+		zram_sddc_cookie_equal(&current_snapshot.ref, &snapshot->ref);
+}
+
+static bool zram_sddc_delta_header_valid(
+		const struct zram_sddc_ref *ref,
+		const struct zram_sddc_delta_header *header, u32 wire_size)
+{
+	if (!ref || !header || wire_size <= sizeof(*header) ||
+	    wire_size > PAGE_SIZE)
+		return false;
+	if (le32_to_cpu(header->magic) != ZRAM_SDDC_DELTA_MAGIC ||
+	    le16_to_cpu(header->version) != ZRAM_SDDC_DELTA_VERSION ||
+	    le16_to_cpu(header->header_size) != sizeof(*header) ||
+	    le32_to_cpu(header->ref_size) != ref->size ||
+	    le32_to_cpu(header->target_size) < ZRAM_SDDC_SAMPLE_SIZE ||
+	    le32_to_cpu(header->target_size) > PAGE_SIZE)
+		return false;
+	return le32_to_cpu(header->ref_id) == ref->cookie.id &&
+		le32_to_cpu(header->ref_generation) == ref->cookie.generation;
+}
+
+static int zram_sddc_restore(struct zram_sddc *sddc,
+				struct zram_sddc_ref *ref,
+				enum zram_sddc_kind kind, const void *wire,
+				u32 wire_size, void *dst, size_t *size,
+				bool full_page)
+{
+	const struct zram_sddc_delta_header *header = wire;
+	struct zcomp *comp = NULL;
+	struct zcomp_strm *zstrm = NULL;
+	unsigned int stream_size;
+	size_t output_size;
+	void *ref_data;
+	bool delta;
+	int ret = 0;
+
+	if (!ref->handle)
+		return -EIO;
+	delta = kind == ZRAM_SDDC_DELTA;
+	if (!delta && kind != ZRAM_SDDC_REF && kind != ZRAM_SDDC_ALIAS)
+		return -EIO;
+	if (delta && !zram_sddc_delta_header_valid(ref, header, wire_size))
+		return -EIO;
+
+	if (delta || (full_page && ref->size != PAGE_SIZE)) {
+		comp = sddc->zram->comps[ref->prio];
+		if (!comp || (delta && !zcomp_supports_delta(comp)))
+			return -EIO;
+		zstrm = zcomp_stream_get(comp);
+	}
+
+	ref_data = zs_map_object(sddc->zram->mem_pool, ref->handle, ZS_MM_RO);
+	if (!delta) {
+		if (zstrm)
+			ret = zcomp_decompress(comp, zstrm, ref_data, ref->size,
+					       dst);
+		else
+			memcpy(dst, ref_data, ref->size);
+		zs_unmap_object(sddc->zram->mem_pool, ref->handle);
+		output_size = full_page ? PAGE_SIZE : ref->size;
+		goto out;
+	}
+
+	stream_size = PAGE_SIZE;
+	ret = zcomp_decompress_delta(zstrm, (const u8 *)wire + sizeof(*header),
+				     wire_size - sizeof(*header), ref_data,
+				     ref->size, zstrm->buffer, &stream_size);
+	zs_unmap_object(sddc->zram->mem_pool, ref->handle);
+	if (ret || stream_size != le32_to_cpu(header->target_size)) {
+		ret = -EIO;
+		goto out;
+	}
+
+	if (!full_page) {
+		memcpy(dst, zstrm->buffer, stream_size);
+		output_size = stream_size;
+	} else if (stream_size == PAGE_SIZE) {
+		memcpy(dst, zstrm->buffer, PAGE_SIZE);
+		output_size = PAGE_SIZE;
+	} else {
+		ret = zcomp_decompress(comp, zstrm, zstrm->buffer, stream_size,
+				       dst);
+		output_size = PAGE_SIZE;
+	}
+
+out:
+	if (zstrm)
+		zcomp_stream_put(comp);
+	if (ret)
+		return -EIO;
+	*size = output_size;
+	return 0;
+}
+
+static int zram_sddc_capture_locked(struct zram_sddc *sddc, u32 index,
+		const struct zram_sddc_snapshot *expected,
+		enum zram_sddc_kind *kind, struct zram_sddc_ref **ref,
+		void *wire, u32 *wire_size)
+{
+	struct zram_sddc_slot_state *state;
+	struct zram *zram = sddc->zram;
+	size_t object_size;
+	void *src;
+
+	if (index >= sddc->nr_slots)
+		return -EAGAIN;
+	state = zram_sddc_state_load_locked(sddc, index);
+	if (expected &&
+	    (sddc->mutation_seq[index] != expected->mutation_seq ||
+	     !state || state->kind != expected->kind ||
+	     !zram_sddc_cookie_equal(&state->ref, &expected->ref)))
+		return -EAGAIN;
+	if (!state)
+		return -EAGAIN;
+	if (zram_sddc_test_flag(zram, index, ZRAM_WB))
+		return -EAGAIN;
+
+	*kind = state->kind;
+	*ref = zram_sddc_ref_pin(sddc, &state->ref);
+	if (!*ref)
+		return -EIO;
+	if ((*ref)->size < ZRAM_SDDC_SAMPLE_SIZE ||
+	    (*ref)->size > PAGE_SIZE || (*ref)->prio >= ZRAM_MAX_COMPS) {
+		zram_sddc_ref_put(*ref);
+		*ref = NULL;
+		return -EIO;
+	}
+
+	*wire_size = 0;
+	object_size = zram_sddc_obj_size(zram, index);
+	if (*kind == ZRAM_SDDC_REF || *kind == ZRAM_SDDC_ALIAS) {
+		if (zram->table[index].handle || object_size) {
+			zram_sddc_ref_put(*ref);
+			*ref = NULL;
+			return -EIO;
+		}
+		return 0;
+	}
+	if (*kind != ZRAM_SDDC_DELTA) {
+		zram_sddc_ref_put(*ref);
+		*ref = NULL;
+		return -EIO;
+	}
+	if (!zram->table[index].handle ||
+	    object_size <= sizeof(struct zram_sddc_delta_header) ||
+	    object_size > PAGE_SIZE) {
+		zram_sddc_ref_put(*ref);
+		*ref = NULL;
+		return -EIO;
+	}
+
+	*wire_size = object_size;
+	src = zs_map_object(zram->mem_pool, zram->table[index].handle, ZS_MM_RO);
+	memcpy(wire, src, *wire_size);
+	zs_unmap_object(zram->mem_pool, zram->table[index].handle);
+	return 0;
+}
+
+int zram_sddc_read_page(struct zram *zram, struct page *page, u32 index)
+{
+	struct zram_sddc_ref *ref = NULL;
+	struct zram_sddc *sddc;
+	enum zram_sddc_kind kind;
+	void *dst;
+	size_t size;
+	u32 wire_size;
+	int ret;
+
+	sddc = zram_sddc_manager_get(zram);
+	if (!sddc)
+		return -EIO;
+
+	dst = kmap_local_page(page);
+	zram_sddc_slot_lock(zram, index);
+	ret = zram_sddc_capture_locked(sddc, index, NULL, &kind, &ref, dst,
+					  &wire_size);
+	zram_sddc_slot_unlock(zram, index);
+	if (!ret)
+		ret = zram_sddc_restore(sddc, ref, kind, dst, wire_size, dst,
+					   &size, true);
+	kunmap_local(dst);
+	if (ret && ret != -EAGAIN)
+		atomic64_inc(&sddc->stats.decode_failures);
+	zram_sddc_ref_put(ref);
+	zram_sddc_manager_put(sddc);
+	return ret;
+}
+
+int zram_sddc_flatten(struct zram *zram, u32 index,
+			 const struct zram_sddc_snapshot *snapshot,
+			 void *dst, size_t *size)
+{
+	struct zram_sddc_ref *ref = NULL;
+	struct zram_sddc *sddc;
+	enum zram_sddc_kind kind;
+	u32 wire_size;
+	int ret;
+
+	if (!zram || !snapshot || !dst || !size)
+		return -EINVAL;
+	sddc = zram_sddc_manager_get(zram);
+	if (!sddc)
+		return -EAGAIN;
+
+	zram_sddc_slot_lock(zram, index);
+	ret = zram_sddc_capture_locked(sddc, index, snapshot, &kind, &ref,
+					  dst, &wire_size);
+	zram_sddc_slot_unlock(zram, index);
+	if (ret) {
+		if (ret != -EAGAIN)
+			atomic64_inc(&sddc->stats.decode_failures);
+		goto out;
+	}
+
+	ret = zram_sddc_restore(sddc, ref, kind, dst, wire_size, dst, size,
+				   false);
+	if (ret)
+		atomic64_inc(&sddc->stats.decode_failures);
+
+out:
+	if (ret && ret != -EAGAIN)
+		atomic64_inc(&sddc->stats.flatten_failures);
+	zram_sddc_ref_put(ref);
+	zram_sddc_manager_put(sddc);
+	return ret;
+}
+
+void zram_sddc_get_stats(struct zram *zram,
+		struct zram_sddc_stats_snapshot *stats)
+{
+	struct zram_sddc *sddc;
+
+	if (!stats)
+		return;
+	memset(stats, 0, sizeof(*stats));
+	if (!zram)
+		return;
+	sddc = zram_sddc_manager_get(zram);
+	if (!sddc)
+		return;
+
+	stats->enabled = true;
+	stats->queued = atomic64_read(&sddc->stats.queued);
+	stats->coalesced = atomic64_read(&sddc->stats.coalesced);
+	stats->dropped = atomic64_read(&sddc->stats.dropped);
+	stats->ineligible = atomic64_read(&sddc->stats.ineligible);
+	stats->shutdown_discarded =
+		atomic64_read(&sddc->stats.shutdown_discarded);
+	stats->worker_runs = atomic64_read(&sddc->stats.worker_runs);
+	stats->observed = atomic64_read(&sddc->stats.observed);
+	stats->stale = atomic64_read(&sddc->stats.stale);
+	stats->indexed = atomic64_read(&sddc->stats.indexed);
+	stats->refs = atomic64_read(&sddc->stats.refs);
+	stats->ref_bytes = atomic64_read(&sddc->stats.ref_bytes);
+	stats->aliases = atomic64_read(&sddc->stats.aliases);
+	stats->deltas = atomic64_read(&sddc->stats.deltas);
+	stats->delta_bytes = atomic64_read(&sddc->stats.delta_bytes);
+	stats->alias_attempts = atomic64_read(&sddc->stats.alias_attempts);
+	stats->alias_hits = atomic64_read(&sddc->stats.alias_hits);
+	stats->delta_attempts = atomic64_read(&sddc->stats.delta_attempts);
+	stats->delta_hits = atomic64_read(&sddc->stats.delta_hits);
+	stats->delta_matches = atomic64_read(&sddc->stats.delta_matches);
+	stats->delta_small_rejects =
+		atomic64_read(&sddc->stats.delta_small_rejects);
+	stats->delta_no_gain = atomic64_read(&sddc->stats.delta_no_gain);
+	stats->delta_match_bytes_max =
+		atomic64_read(&sddc->stats.delta_match_bytes_max);
+	stats->saved_bytes = atomic64_read(&sddc->stats.saved_bytes);
+	stats->saved_bytes_total =
+		atomic64_read(&sddc->stats.saved_bytes_total);
+	stats->conversion_failures =
+		atomic64_read(&sddc->stats.conversion_failures);
+	stats->decode_failures = atomic64_read(&sddc->stats.decode_failures);
+	stats->flatten_failures = atomic64_read(&sddc->stats.flatten_failures);
+	stats->limit_rejects = atomic64_read(&sddc->stats.limit_rejects);
+	stats->pending_max = atomic64_read(&sddc->stats.pending_max);
+	spin_lock(&sddc->state_lock);
+	stats->pending = sddc->pending;
+	spin_unlock(&sddc->state_lock);
+	zram_sddc_manager_put(sddc);
+}
+
+void zram_sddc_queue_observation(struct zram *zram,
+		const struct zram_sddc_job_key *key)
+{
+	struct zram_sddc *sddc;
+	u32 index;
+	unsigned int first_work;
+	unsigned int i;
+
+	if (!zram || !key || !key->handle ||
+	    key->size < ZRAM_SDDC_SAMPLE_SIZE || key->size > PAGE_SIZE)
+		return;
+	sddc = zram_sddc_manager_get(zram);
+	if (!sddc)
+		return;
+	index = key->index;
+	if (index >= sddc->nr_slots) {
+		atomic64_inc(&sddc->stats.dropped);
+		goto put_manager;
+	}
+
+	spin_lock(&sddc->state_lock);
+	if (READ_ONCE(sddc->stopping))
+		goto reject_locked;
+	if (!zram_sddc_observe_mark_locked(sddc, index))
+		goto put_locked;
+	atomic64_inc(&sddc->stats.queued);
+	if (!zram_sddc_observe_activate_locked(sddc))
+		goto put_locked;
+
+	/* One active manager token belongs to the newly scheduled drain. */
+	first_work = sddc->observe_work_cursor++ %
+		ZRAM_SDDC_OBSERVE_WORKS;
+	for (i = 0; i < ZRAM_SDDC_OBSERVE_WORKS; i++) {
+		unsigned int work_index = (first_work + i) %
+			ZRAM_SDDC_OBSERVE_WORKS;
+
+		spin_lock(&sddc->active_lock);
+		atomic_inc(&sddc->active_ops);
+		spin_unlock(&sddc->active_lock);
+		if (queue_work(sddc->workqueue,
+				&sddc->observe_work[work_index].work)) {
+			sddc->observe_work_cursor = (work_index + 1) %
+				ZRAM_SDDC_OBSERVE_WORKS;
+			break;
+		}
+		zram_sddc_manager_put(sddc);
+	}
+	spin_unlock(&sddc->state_lock);
+	zram_sddc_manager_put(sddc);
+	return;
+
+put_locked:
+	spin_unlock(&sddc->state_lock);
+	goto put_manager;
+reject_locked:
+	spin_unlock(&sddc->state_lock);
+	atomic64_inc(&sddc->stats.dropped);
+put_manager:
+	zram_sddc_manager_put(sddc);
+}
