+static void zram_sddc_delta_header_test(struct kunit *test)
+{
+	struct zram_sddc_ref ref = {
+		.cookie = { .id = 37, .generation = 13 },
+		.size = 768,
+	};
+	struct zram_sddc_delta_header header = {
+		.magic = cpu_to_le32(ZRAM_SDDC_DELTA_MAGIC),
+		.version = cpu_to_le16(ZRAM_SDDC_DELTA_VERSION),
+		.header_size = cpu_to_le16(sizeof(header)),
+		.ref_id = cpu_to_le32(ref.cookie.id),
+		.ref_generation = cpu_to_le32(ref.cookie.generation),
+		.ref_size = cpu_to_le32(ref.size),
+		.target_size = cpu_to_le32(640),
+	};
+	struct zram_sddc_delta_header bad;
+	u32 wire_size = sizeof(header) + 8;
+
+	KUNIT_ASSERT_TRUE(test,
+			zram_sddc_delta_header_valid(&ref, &header, wire_size));
+
+	bad = header;
+	bad.magic = cpu_to_le32(ZRAM_SDDC_DELTA_MAGIC ^ 1);
+	KUNIT_EXPECT_FALSE(test,
+			zram_sddc_delta_header_valid(&ref, &bad, wire_size));
+	bad = header;
+	bad.version = cpu_to_le16(ZRAM_SDDC_DELTA_VERSION + 1);
+	KUNIT_EXPECT_FALSE(test,
+			zram_sddc_delta_header_valid(&ref, &bad, wire_size));
+	bad = header;
+	bad.header_size = cpu_to_le16(sizeof(bad) - 1);
+	KUNIT_EXPECT_FALSE(test,
+			zram_sddc_delta_header_valid(&ref, &bad, wire_size));
+	bad = header;
+	bad.ref_id = cpu_to_le32(ref.cookie.id + 1);
+	KUNIT_EXPECT_FALSE(test,
+			zram_sddc_delta_header_valid(&ref, &bad, wire_size));
+	bad = header;
+	bad.ref_generation = cpu_to_le32(ref.cookie.generation + 1);
+	KUNIT_EXPECT_FALSE(test,
+			zram_sddc_delta_header_valid(&ref, &bad, wire_size));
+	bad = header;
+	bad.ref_size = cpu_to_le32(ref.size + 1);
+	KUNIT_EXPECT_FALSE(test,
+			zram_sddc_delta_header_valid(&ref, &bad, wire_size));
+	bad = header;
+	bad.target_size = 0;
+	KUNIT_EXPECT_FALSE(test,
+			zram_sddc_delta_header_valid(&ref, &bad, wire_size));
+	bad = header;
+	bad.target_size = cpu_to_le32(PAGE_SIZE + 1);
+	KUNIT_EXPECT_FALSE(test,
+			zram_sddc_delta_header_valid(&ref, &bad, wire_size));
+	KUNIT_EXPECT_FALSE(test, zram_sddc_delta_header_valid(&ref, &header,
+			sizeof(header)));
+	KUNIT_EXPECT_FALSE(test, zram_sddc_delta_header_valid(&ref, &header,
+			PAGE_SIZE + 1));
+}
