+static void zram_sddc_flatten_snapshot_test(struct kunit *test)
+{
+	struct zram_sddc_test_ctx *ctx = test->priv;
+	struct zram_sddc_slot_state *state;
+	struct zram_sddc_snapshot snapshot;
+	void *dst;
+	size_t size = 123;
+	int ret;
+
+	ctx->mutation_seq[0] = 27;
+	state = zram_sddc_test_install_state(ctx, 0,
+			ZRAM_SDDC_ALIAS);
+	KUNIT_ASSERT_NOT_NULL(test, state);
+	state->ref.id = 2;
+	state->ref.generation = 4;
+	zram_sddc_slot_lock(&ctx->zram, 0);
+	zram_sddc_snapshot_locked(&ctx->zram, 0, &snapshot);
+	zram_sddc_slot_unlock(&ctx->zram, 0);
+	ctx->mutation_seq[0]++;
+	dst = kunit_kmalloc(test, PAGE_SIZE, GFP_KERNEL);
+	KUNIT_ASSERT_NOT_NULL(test, dst);
+
+	ret = zram_sddc_flatten(&ctx->zram, 0, &snapshot, dst, &size);
+	KUNIT_EXPECT_EQ(test, ret, -EAGAIN);
+	KUNIT_EXPECT_EQ(test, size, (size_t)123);
+	KUNIT_EXPECT_EQ(test, atomic_read(&ctx->sddc.active_ops), 0);
+	KUNIT_EXPECT_EQ(test,
+			atomic64_read(&ctx->sddc.stats.flatten_failures), (s64)0);
+
+	zram_sddc_slot_lock(&ctx->zram, 0);
+	zram_sddc_snapshot_locked(&ctx->zram, 0, &snapshot);
+	zram_sddc_slot_unlock(&ctx->zram, 0);
+	ret = zram_sddc_flatten(&ctx->zram, 0, &snapshot, dst, &size);
+	KUNIT_EXPECT_EQ(test, ret, -EIO);
+	KUNIT_EXPECT_EQ(test, atomic_read(&ctx->sddc.active_ops), 0);
+	KUNIT_EXPECT_EQ(test,
+			atomic64_read(&ctx->sddc.stats.decode_failures), (s64)1);
+	KUNIT_EXPECT_EQ(test,
+			atomic64_read(&ctx->sddc.stats.flatten_failures), (s64)1);
+}
